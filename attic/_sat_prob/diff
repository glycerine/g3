diff --git a/pkg/sat/sat_prob.go b/pkg/sat/sat_prob.go
new file mode 100644
index 000000000..fcb614206
--- /dev/null
+++ b/pkg/sat/sat_prob.go
@@ -0,0 +1,91 @@
+package sat
+
+// Source: src/sat/sat_prob.h; sat_prob.cpp:24-47,191-245.
+
+import (
+	"math"
+
+	"github.com/glycerine/g3/pkg/util/control"
+	"github.com/glycerine/g3/pkg/util/lbool"
+	z3rand "github.com/glycerine/g3/pkg/util/random"
+)
+
+type satProbClauseInfo struct{ truths, sum uint32 }
+
+type satProb struct {
+	limit                    *control.Reslimit
+	random                   *z3rand.Generator
+	clauses                  [][]Literal
+	info                     []satProbClauseInfo
+	values, best             []bool
+	use                      [][]uint32
+	breaks                   []uint32
+	unsat                    []uint32
+	unsatPos                 []int
+	probBreak, probabilities []float64
+	model                    Model
+	bestUnsat                uint32
+	flips, nextRestart       uint64
+	restarts                 uint32
+	restartOffset            uint64
+	randomInit               uint32
+}
+
+func newSATProb(limit *control.Reslimit, seed uint32) *satProb {
+	return &satProb{limit: limit, random: z3rand.New(seed), restartOffset: 1000000, randomInit: 4}
+}
+
+func (p *satProb) check() lbool.LBool {
+	p.initialize()
+	for p.bestUnsat != 0 && p.limit.Inc() {
+		if p.flips >= p.nextRestart {
+			p.restart()
+		} else {
+			p.flipOne()
+		}
+	}
+	if p.bestUnsat == 0 {
+		return lbool.True
+	}
+	return lbool.Undef
+}
+
+func (p *satProb) initialize() {
+	for i := range p.values {
+		p.values[i] = p.random.Next()%2 == 0
+	}
+	p.initializeClauses()
+	p.autoConfigure()
+	p.saveBest()
+	p.restarts, p.flips = 1, 0
+	p.nextRestart = p.restartOffset
+}
+
+func (p *satProb) autoConfigure() {
+	maxLen, maxOcc := 0, 0
+	for _, c := range p.clauses {
+		if len(c) > maxLen {
+			maxLen = len(c)
+		}
+	}
+	for _, u := range p.use {
+		if len(u) > maxOcc {
+			maxOcc = len(u)
+		}
+	}
+	cb := 5.4
+	switch maxLen {
+	case 0, 1, 2, 3:
+		cb = 2.5
+	case 4:
+		cb = 2.85
+	case 5:
+		cb = 3.7
+	case 6:
+		cb = 5.1
+	}
+	p.probBreak = make([]float64, maxOcc+1)
+	for i := range p.probBreak {
+		p.probBreak[i] = math.Pow(cb, -float64(i))
+	}
+}
diff --git a/pkg/sat/sat_prob_clause.go b/pkg/sat/sat_prob_clause.go
new file mode 100644
index 000000000..14b42e17f
--- /dev/null
+++ b/pkg/sat/sat_prob_clause.go
@@ -0,0 +1,82 @@
+package sat
+
+// Source: src/sat/sat_prob.cpp:92-151,167-189.
+
+func (p *satProb) reserveVariables(n uint32) {
+	for uint32(len(p.values)) < n {
+		p.values = append(p.values, false)
+		p.best = append(p.best, false)
+		p.breaks = append(p.breaks, 0)
+	}
+}
+
+func (p *satProb) addClause(input []Literal) {
+	c := append([]Literal(nil), input...)
+	idx := uint32(len(p.clauses))
+	p.clauses = append(p.clauses, c)
+	p.info = append(p.info, satProbClauseInfo{})
+	for _, l := range c {
+		p.reserveVariables(uint32(l.variable()) + 1)
+		for len(p.use) <= int(l.index()) {
+			p.use = append(p.use, nil)
+		}
+		p.use[l.index()] = append(p.use[l.index()], idx)
+	}
+}
+
+func (p *satProb) literalTrue(l Literal) bool { return p.values[l.variable()] != l.sign() }
+func (p *satProb) initializeClauses() {
+	for i := range p.breaks {
+		p.breaks[i] = 0
+	}
+	p.unsat = nil
+	p.unsatPos = make([]int, len(p.clauses))
+	for i := range p.unsatPos {
+		p.unsatPos[i] = -1
+	}
+	for i, c := range p.clauses {
+		ci := satProbClauseInfo{}
+		for _, l := range c {
+			if p.literalTrue(l) {
+				ci.truths++
+				ci.sum += l.index()
+			}
+		}
+		p.info[i] = ci
+		if ci.truths == 0 {
+			p.insertUnsat(uint32(i))
+		} else if ci.truths == 1 {
+			p.breaks[Literal(ci.sum).variable()]++
+		}
+	}
+}
+func (p *satProb) insertUnsat(i uint32) {
+	if p.unsatPos[i] >= 0 {
+		return
+	}
+	p.unsatPos[i] = len(p.unsat)
+	p.unsat = append(p.unsat, i)
+}
+func (p *satProb) removeUnsat(i uint32) {
+	pos := p.unsatPos[i]
+	if pos < 0 {
+		return
+	}
+	last := p.unsat[len(p.unsat)-1]
+	p.unsat[pos] = last
+	p.unsatPos[last] = pos
+	p.unsat = p.unsat[:len(p.unsat)-1]
+	p.unsatPos[i] = -1
+}
+func (p *satProb) saveBest() {
+	p.bestUnsat = uint32(len(p.unsat))
+	copy(p.best, p.values)
+	p.model = make(Model, len(p.values))
+	for i, v := range p.values {
+		if v {
+			p.model[i] = 1
+		} else {
+			p.model[i] = -1
+		}
+	}
+}
diff --git a/pkg/sat/sat_prob_flip.go b/pkg/sat/sat_prob_flip.go
new file mode 100644
index 000000000..b70767952
--- /dev/null
+++ b/pkg/sat/sat_prob_flip.go
@@ -0,0 +1,69 @@
+package sat
+
+// Source: src/sat/sat_prob.cpp:49-91.
+
+func (p *satProb) pickVar() BoolVar {
+	ci := p.unsat[p.random.Next()%uint32(len(p.unsat))]
+	c := p.clauses[ci]
+	if cap(p.probabilities) < len(c) {
+		p.probabilities = make([]float64, len(c))
+	} else {
+		p.probabilities = p.probabilities[:len(c)]
+	}
+	sum := 0.0
+	for i, l := range c {
+		q := p.probBreak[p.breaks[l.variable()]]
+		p.probabilities[i] = q
+		sum += q
+	}
+	lim := sum * float64(p.random.Next()) / float64(0x7fff)
+	i := len(c)
+	for {
+		i--
+		lim -= p.probabilities[i]
+		if lim < 0 || i == 0 {
+			break
+		}
+	}
+	return c[i].variable()
+}
+func (p *satProb) flipOne() {
+	p.flip(p.pickVar())
+	if uint32(len(p.unsat)) < p.bestUnsat {
+		p.saveBest()
+	}
+}
+func (p *satProb) flip(v BoolVar) {
+	p.flips++
+	lit := MakeLiteral(v, !p.values[v])
+	nlit := lit.Negated()
+	if int(lit.index()) < len(p.use) {
+		for _, idx := range p.use[lit.index()] {
+			ci := &p.info[idx]
+			ci.truths--
+			ci.sum -= lit.index()
+			switch ci.truths {
+			case 0:
+				p.insertUnsat(idx)
+				p.breaks[v]--
+			case 1:
+				p.breaks[Literal(ci.sum).variable()]++
+			}
+		}
+	}
+	if int(nlit.index()) < len(p.use) {
+		for _, idx := range p.use[nlit.index()] {
+			ci := &p.info[idx]
+			switch ci.truths {
+			case 0:
+				p.removeUnsat(idx)
+				p.breaks[v]++
+			case 1:
+				p.breaks[Literal(ci.sum).variable()]--
+			}
+			ci.truths++
+			ci.sum += nlit.index()
+		}
+	}
+	p.values[v] = !p.values[v]
+}
diff --git a/pkg/sat/sat_prob_restart.go b/pkg/sat/sat_prob_restart.go
