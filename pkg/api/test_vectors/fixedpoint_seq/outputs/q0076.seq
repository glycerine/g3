sort S bv 2
param engine datalog
param xform.fix_unbound_vars true
param xform.magic true
setparams
vars x S y S z S
rel r0 S S
rel r1 S S S
rel r2 S S S
fact r0 3 1
fact r0 1 0
fact r0 0 1
fact r0 0 0
rule n0 (=> (and (r0 x y) (r0 y 0:S)) (r2 y z x))
rule n1 (=> (and (r0 x y) (r2 y x y)) (r2 3:S z x))
rule n2 (=> (r2 z y 0:S) (r2 z 1:S z))
rule n3 (=> (and (r1 z x z) (r2 z z z)) (r2 1:S y 0:S))
rule n4 (=> (r0 y x) (r1 z z x))
query (r2 x y z)
push
rule n0 (=> (and (r1 y z x) (r1 z x y) (not (r0 z x))) (r2 y z x))
fact r0 0 2
fact r0 0 3
fact r0 0 0
fact r2 0 1 1
fact r0 2 1
query (r0 z y)
pop
qrel r2 r1
param xform.bit_blast true
setparams
query (and (r1 x z 1:S) (r2 y x y))
param xform.karr true
setparams
query (and (r2 z x z) (r0 x y))
