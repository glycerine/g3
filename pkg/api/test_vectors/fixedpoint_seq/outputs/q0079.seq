sort S bv 3
param engine datalog
param datalog.default_relation pentagon
param datalog.magic_sets_for_queries true
param datalog.output_profile true
param datalog.generate_explanations true
setparams
vars x S y S z S
rel r0 S S
rel r1 S
rel r2 S S
rel r3 S S
repr r2 tr_bitvector
fact r2 5 1
fact r0 1 2
fact r0 3 7
fact r2 3 7
rule n0 (=> (r3 z z) (r2 7:S z))
rule n1 (=> (and (r1 z) (r2 y 7:S)) (r2 2:S y))
rule n2 (=> (and (r0 3:S z) (r2 z z) (r3 z 7:S)) (r3 x z))
query (r3 4:S y)
push
rule n0 (=> (and (r3 x 1:S) (r0 6:S y) (r3 z x)) (r2 x z))
fact r0 3 6
fact r1 7
fact r0 2 6
query (r0 x z)
pop
query (r3 6:S 5:S)
