(declare-sort hrb.node 0)
(declare-fun hrb.member_fa (hrb.node) Bool)
(declare-fun hrb.member_fs (hrb.node) Bool)
(declare-fun hrb.member_fi (hrb.node) Bool)
(declare-fun hrb.member_fc (hrb.node) Bool)
(declare-fun hrb.correct (hrb.node) Bool)
(declare-fun @N () hrb.node)
(declare-fun hrb.rcv_init (hrb.node) Bool)
(declare-fun l2s_g_2 (hrb.node hrb.node) Bool)
(declare-fun @M () hrb.node)
(assert (forall ((|N:hrb.node| hrb.node))
  (= (hrb.correct |N:hrb.node|)
     (and (not (hrb.member_fc |N:hrb.node|))
          (not (hrb.member_fi |N:hrb.node|))
          (not (hrb.member_fs |N:hrb.node|))
          (not (hrb.member_fa |N:hrb.node|))))))
(assert (hrb.correct @N))
(assert (hrb.rcv_init @N))
(assert (l2s_g_2 @N @M))

