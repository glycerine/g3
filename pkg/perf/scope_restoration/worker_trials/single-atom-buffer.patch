+// smtClauseAtomBuffer serves temporary atom owners from one solver-local
+// slab. Live clauses keep their spans until every release has succeeded.
+type smtClauseAtomBuffer struct {
+	atoms        [256]smtClauseAtom
+	used, owners int
+}
+
+func (c *SMTClause) discardAtoms() {
+	c.atoms = nil
+	if buf := c.atomBuffer; buf != nil {
+		buf.owners--
+		if buf.owners == 0 {
+			buf.used = 0
+		}
+		c.atomBuffer = nil
+	}
+}
