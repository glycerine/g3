+type smtClauseAtomCache struct{ free [][]smtClauseAtom }
+
+const shortAtomCount = 4
+const shortAtomCacheLimit = 64
+
+func (c *smtClauseAtomCache) take(n int) []smtClauseAtom {
+	if c == nil || n > shortAtomCount {
+		return make([]smtClauseAtom, n)
+	}
+	end := len(c.free) - 1
+	if end < 0 {
+		return make([]smtClauseAtom, n, shortAtomCount)
+	}
+	a := c.free[end]
+	c.free[end] = nil
+	c.free = c.free[:end]
+	return a[:n]
+}
+
+func (c *smtClauseAtomCache) put(a []smtClauseAtom) {
+	if cap(a) == shortAtomCount && len(c.free) < shortAtomCacheLimit {
+		c.free = append(c.free, a[:0])
+	}
+}
