+// Restore an uninterpreted constant into a recycled Boolean slot.
+func (d *SMTBoolVarData) resetLeaf(level uint32) {
+	if d.justification != (SMTBooleanJustification{}) {
+		d.justification = SMTBooleanJustification{}
+	}
+	d.ScopeLevel = 0
+	d.Mark, d.Assumption, d.PhaseAvailable, d.Phase = false, false, false, false
+	d.equality, d.trueFirst, d.enode, d.quantifier = false, false, false, false
+	d.internalLevel = level
+	d.atom, d.notifyTheory, d.basicOp = false, 0, -1
+	d.notChild = ast.ASTHandle{}
+	if d.gateArgs != nil {
+		d.gateArgs = nil
+	}
+	if d.gateLiterals != nil {
+		d.gateLiterals = nil
+	}
