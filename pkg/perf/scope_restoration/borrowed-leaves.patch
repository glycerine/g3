+func (m *ASTManager) StudyPin(h ASTHandle, pin bool) {
+	n := m.nodeAt(h.slot)
+	if !n.live || n.rc != 1 || n.generation != h.generation || m.origin != h.origin {
+		panic("unbalanced study root")
+	}
+	n.studyPinned = pin
