+func BenchmarkStudyASTChurn(b *testing.B) {
+	m := astTestManager(b)
+	sort, err := m.MkBoolSort()
+	benchmarkMust(b, err)
+	var nodes [128]ast.ASTHandle
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		for j := range nodes {
+			nodes[j], err = m.MkVar(uint32(j), sort)
+			benchmarkMust(b, err)
+			benchmarkMust(b, m.IncRef(nodes[j]))
+		}
+		for _, h := range nodes {
+			benchmarkMust(b, m.DecRef(h))
+		}
+	}
+}
