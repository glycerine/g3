+type studyChild struct{ mark, negative *smtExprRecord }
+type studyRecordGate struct {
+	args   []ast.ASTHandle
+	parent *smtExprRecord
+	values []studyChild
+}
+
+func (p *SMTRelevancyPropagator) studyRecordWatches(parent ast.ASTHandle, args []ast.ASTHandle, lits []SMTLiteral) error {
+	if !p.enabled {
+		return nil
+	}
+	h := smtRelevancyHandler{kind: smtRelevancyOr, target: parent}
+	ok := true
+	for _, l := range lits {
+		if l.Var() <= 0 {
+			ok = false
+			break
+		}
+	}
+	if ok {
+		var g *studyRecordGate
+		if len(args) <= 4 {
+			block := new(struct {
+				g      studyRecordGate
+				values [4]studyChild
+			})
+			g = &block.g
+			g.values = block.values[:len(args):len(args)]
+		} else {
+			g = &studyRecordGate{}
+			g.values = make([]studyChild, len(args))
+		}
+		g.args = args
+		g.parent = p.context.exprs.write(parent)
+		for i, l := range lits {
+			atom := p.internalizer.boolExpr[l.Var()]
+			g.values[i].mark = p.context.exprs.write(args[i])
+			if l.Sign() {
+				g.values[i].negative = p.context.exprs.write(atom)
+			}
+		}
+		h.root = g
+	}
+	for _, arg := range args {
+		if err := p.addLiteralWatch(arg, true, &h); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func (p *SMTRelevancyPropagator) studyAtom(r *smtExprRecord) lbool.LBool {
+	if p.internalizer != nil && r.flags&smtExprHasBoolVar != 0 {
+		return p.internalizer.assignment[r.boolVar<<1]
+	}
+	value, _ := p.context.assignments.lookupRecord(r)
+	return value
+}
+func (p *SMTRelevancyPropagator) studyRecordOR(parent ast.ASTHandle, g *studyRecordGate) error {
+	if g.parent.generation != parent.Generation() || g.parent.flags&smtExprRelevant == 0 {
+		return nil
+	}
+	if p.studyAtom(g.parent) == lbool.False {
+		for i := len(g.args) - 1; i >= 0; i-- {
+			if err := p.MarkRelevant(g.args[i]); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	first := -1
+
+	for i, arg := range g.args {
+		var value lbool.LBool
+		child := g.values[i]
+		if child.negative != nil {
+			value, _ = p.context.assignments.lookupRecord(child.negative)
+			value = value.Negated()
+		} else {
+			value = p.studyAtom(child.mark)
+		}
+		_ = arg
+		if value != lbool.True {
+			continue
+		}
+		if child.mark.flags&smtExprRelevant != 0 {
+			return nil
+		}
+		if first < 0 {
+			first = i
+		}
+	}
+	if first >= 0 {
+		return p.MarkRelevant(g.args[first])
+	}
+	return nil
+}
