+func (m *ASTManager) GetFamilyAndDeclKind(h ASTHandle) (FamilyID, int32, error) {
+	r := astNodeRef{h.slot, h.generation}
+	if !m.fastHandle(h) {
+		var e error
+		if r, e = m.readNodeChecked(h); e != nil {
+			return NullFamilyID, -1, e
+		}
+	}
+	slot := m.nodeSlotAt(r.slot)
+	if slot.node.kind == ASTApp {
+		return m.appIdentity(&slot.app)
+	}
+	return m.declIdentity(r)
+}
