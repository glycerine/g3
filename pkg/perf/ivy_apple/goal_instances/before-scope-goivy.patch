+func (s *Z3Solver) StudyProveBefore(roots []Z3Expr) bool {
+	var yes bool
+	s.ctx.do(func() {
+		batch := s.studyBatch
+		if batch == nil {
+			batch = s.c.BeginOrderProofBatch()
+			defer batch.Close()
+		}
+		y, e := batch.StudyProveRoots(exprHandles(roots))
+		yes = y && e == nil
+	})
+	return yes
+}
