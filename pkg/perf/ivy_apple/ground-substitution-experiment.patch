+// A compiled ground substitution supplies live children at the original domain sorts.
+func (m *ASTManager) StudyExistingApp(decl ASTHandle, args []ASTHandle) ASTHandle {
+	if len(args) > astInlineArgs || len(m.table.indices) == 0 {
+		return ASTHandle{}
+	}
+	refs := [astInlineArgs]astNodeRef{}
+	hashes := [astInlineArgs]uint32{}
+	dr, err := m.internal(decl)
+	if err != nil {
+		return ASTHandle{}
+	}
+	for i, h := range args {
+		r, e := m.internal(h)
+		if e != nil {
+			return ASTHandle{}
+		}
+		refs[i] = r
+		hashes[i] = m.nodeAt(r.slot).hash
+	}
+	hash := astTableHash(astHashArray(uint32(len(args)), m.nodeAt(dr.slot).hash, func(i uint32) uint32 { return hashes[i] }))
+	t := &m.table
+	tag := astTableTag(hash)
+	i, perturb := hash&t.mask, hash
+	for {
+		ctrl := t.tags[i]
+		if ctrl == astTagEmpty {
+			return ASTHandle{}
+		}
+		if ctrl == tag {
+			e := t.entries[t.indices[i]]
+			if e.hash == hash && m.nodeAt(e.ref.slot).kind == ASTApp {
+				a := m.appAt(e.ref.slot)
+				if a.decl == dr && a.count == uint32(len(args)) {
+					all := true
+					for j := range args {
+						if a.inlineArgs[j] != refs[j] {
+							all = false
+							break
+						}
+					}
+					if all {
+						return m.external(e.ref)
+					}
+				}
+			}
+		}
+		perturb >>= 5
+		i = (5*i + perturb + 1) & t.mask
+	}
+}
