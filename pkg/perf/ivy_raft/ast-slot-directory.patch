diff --git a/pkg/ast/ast_node_directory_test.go b/pkg/ast/ast_node_directory_test.go
new file mode 100644
index 000000000..6e53f414d
--- /dev/null
+++ b/pkg/ast/ast_node_directory_test.go
@@ -0,0 +1,43 @@
+package ast
+
+import (
+	"errors"
+	"math"
+	"testing"
+
+	"github.com/glycerine/g3/pkg/arena"
+)
+
+func TestASTNodeDirectoryGrowthAndPageRetry(t *testing.T) {
+	m := ASTManager{BudgetField: arena.NewBudget(math.MaxUint64)}
+	astTestMust(t, m.ensureNodePage(1))
+	first := m.nodes[0]
+	first.node.id = 7
+	next := uint32(cap(m.nodes) + astPageSize + 1)
+	m.BudgetField.FailAfter(1) // allow the new directory and fail its first page
+	if err := m.ensureNodePage(next); !errors.Is(err, arena.ErrInjectedFailure) {
+		t.Fatal(err)
+	}
+	if m.nodes[next-1] != nil || m.nodes[0] != first || first.node.id != 7 || m.pageBytes != astNodePageBytes {
+		t.Fatal("failed page allocation changed published slots or charges")
+	}
+	if got := m.BudgetField.Used(); got != m.pageBytes+m.directoryBytes {
+		t.Fatal("directory growth charge", got, m.pageBytes, m.directoryBytes)
+	}
+	m.BudgetField.FailAfter(-1)
+	astTestMust(t, m.ensureNodePage(next))
+	newSlot := m.nodes[next-1]
+	if newSlot == nil || newSlot == first || m.nodes[0] != first || m.pageBytes != 2*astNodePageBytes {
+		t.Fatal("page retry changed an earlier slot")
+	}
+	before := m.BudgetField.Used()
+	m.BudgetField.FailAfter(0)
+	astTestMust(t, m.ensureNodePage(next))
+	if m.nodes[next-1] != newSlot || m.BudgetField.Used() != before {
+		t.Fatal("existing slot changed")
+	}
+	m.releasePages()
+	if m.nodes != nil || m.BudgetField.Used() != 0 {
+		t.Fatal("released directory still charged")
+	}
+}
