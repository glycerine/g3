+func (m *ASTManager) knownRewriteFold(a *astAppRecord) int16 {
+	if !a.declCached || ASTSourceDebug {
+		return 0
+	}
+	if a.declFamily == m.BasicFamilyID() && (a.declKind == ASTOpIte || a.declKind == ASTOpAnd || a.declKind == ASTOpOr) {
+		return int16(a.declKind)
+	}
+	return -1
+}
+
+func (m *ASTManager) FirstRewriteArg(h ASTHandle) (ASTHandle, int16, error) {
+	const index = 0
+	r := astNodeRef{h.slot, h.generation}
+	if !m.fastHandle(h) {
+		var e error
+		if r, e = m.readNodeChecked(h); e != nil {
+			return ASTHandle{}, 0, e
+		}
+	}
+	if m.nodeAt(r.slot).kind != ASTApp {
+		return ASTHandle{}, 0, ErrASTDomain
+	}
+	v := m.appAt(r.slot)
+	if index >= v.count {
+		return ASTHandle{}, 0, ErrASTDomain
+	}
+	if index < astInlineArgs && !ASTSourceDebug { // appArg's inline arguments
+		return m.external(v.inlineArgs[index]), m.knownRewriteFold(v), nil
+	}
+	child, e := m.appArg(v, index)
+	return m.external(child), m.knownRewriteFold(v), e
+}
