+package rewriter
+
+import "github.com/glycerine/g3/pkg/ast"
+
+type subPlanOp struct {
+	source, decl ast.ASTHandle
+	arity        uint32
+	offset       uint16
+	kind         ast.ASTKind
+	ground, ite  bool
+}
+type subPlan struct {
+	ops   []subPlanOp
+	edges []uint16
+	index map[ast.ASTHandle]uint16
+}
+type subPlanEntry struct {
+	root ast.ASTHandle
+	hits uint16
+	plan *subPlan
+}
+
+func (s *VarSubstitution) choosePlan(root ast.ASTHandle) *subPlan {
+	m := s.reducer.engine.core.manager
+	if m.Budget().InjectionArmed() {
+		return nil
+	}
+	for i := range s.seen {
+		entry := &s.seen[i]
+		if entry.root != root {
+			continue
+		}
+		if entry.hits < 2 {
+			entry.hits++
+			if entry.hits == 2 {
+				p := &subPlan{index: make(map[ast.ASTHandle]uint16), ops: make([]subPlanOp, 1, 16)}
+				if _, ok := p.add(m, root, 0); ok {
+					entry.plan = p
+				}
+			}
+		}
+		return entry.plan
+	}
+	s.seen[s.nextSeen] = subPlanEntry{root: root, hits: 1}
+	s.nextSeen = (s.nextSeen + 1) % uint8(len(s.seen))
+	return nil
+}
+
+func (p *subPlan) add(m *ast.ASTManager, t ast.ASTHandle, depth int) (uint16, bool) {
+	if i, ok := p.index[t]; ok {
+		return i, true
+	}
+	if len(p.ops) >= 192 || depth >= 48 || m.Limit.CancelFlag() {
+		return 0, false
+	}
+	kind, _, n, ground, err := m.SubstitutionShape(t)
+	if err != nil || (!ground && kind != ast.ASTVar && kind != ast.ASTApp) {
+		return 0, false
+	}
+	id := uint16(len(p.ops))
+	p.index[t] = id
+	op := subPlanOp{source: t, arity: n, ground: ground, kind: kind}
+	p.ops = append(p.ops, op)
+	if kind != ast.ASTApp || ground {
+		return id, true
+	}
+	if n == 0 || n > 64 || len(p.edges)+int(n) > 512 {
+		return 0, false
+	}
+	d, err := m.GetDecl(t)
+	if err != nil {
+		return 0, false
+	}
+	_, fid, k, err := m.AppIdentity(t)
+	if err != nil {
+		return 0, false
+	}
+	op.offset = uint16(len(p.edges))
+	op.decl = d
+	op.ite = fid == m.BasicFamilyID() && k == ast.ASTOpIte
+	p.ops[id] = op
+	p.edges = append(p.edges, make([]uint16, n)...)
+	for i := uint32(0); i < n; i++ {
+		ch, err := m.GetArg(t, i)
+		if err != nil {
+			return 0, false
+		}
+		k, ok := p.add(m, ch, depth+1)
+		if !ok {
+			return 0, false
+		}
+		p.edges[int(op.offset)+int(i)] = k
+	}
+	return id, true
+}
+
+func (r *rewriterEngine) visitPlan(id uint16, depth uint32) (bool, error) {
+	c := &r.core
+	m := c.manager
+	op := &r.plan.ops[id]
+	t := op.source
+	if depth == 0 || op.ground {
+		return true, appendRewriterRoot(m, &c.results, t)
+	}
+	if op.kind == ast.ASTVar {
+		return true, r.processBoundVariable(t, op.arity)
+	}
+	rc, e := m.GetRefCount(t)
+	if e != nil {
+		return false, e
+	}
+	cache := c.mustCacheShape(t, op.kind, rc, op.arity)
+	if cache {
+		h, e := c.getCached(t)
+		if e != nil {
+			return false, e
+		}
+		if !h.IsNull() {
+			if e = appendRewriterRoot(m, &c.results, h); e != nil {
+				return false, e
+			}
+			return true, r.setNewChildIfDifferent(t, h)
+		}
+	}
+	if depth != 3 {
+		depth--
+	}
+	if e = c.pushFrameCore(t, cache, 0, depth, op.kind, op.arity); e != nil {
+		return false, e
+	}
+	c.frames[len(c.frames)-1].planIndex = id
+	return false, nil
+}
+
+func (r *rewriterEngine) processPlanApp(fi int, fr rewriterFrame) error {
+	c := &r.core
+	m := c.manager
+	op := &r.plan.ops[fr.planIndex]
+	for c.frames[fi].index() < op.arity {
+		i := c.frames[fi].index()
+		if i == 1 && op.ite {
+			folded, e := r.constantFold(fi)
+			if e != nil || folded {
+				return e
+			}
+		}
+		c.frames[fi].setIndex(i + 1)
+		child := r.plan.edges[int(op.offset)+int(i)]
+		done, e := r.visitPlan(child, fr.maxDepth())
+		if e != nil || !done {
+			return e
+		}
+	}
+	fr = c.frames[fi]
+	h := op.source
+	if fr.newChild() {
+		args, e := c.resultArguments(fr.spos, uint32(len(c.results))-fr.spos)
+		if e != nil {
+			return e
+		}
+		h, e = m.RewriterMakeApp(op.decl, args)
+		if e != nil {
+			return e
+		}
+	}
+	if e := m.SetRefHeld(r.r, h); e != nil {
+		return e
+	}
+	return r.finish(fr, false, true)
+}
