+
+// BorrowedRewriteApp is valid while a rewrite frame holds the source AST.
+type BorrowedRewriteApp struct{ slot *astNodeSlot }
+
+func (m *ASTManager) BorrowRewriteApp(h ASTHandle) BorrowedRewriteApp {
+	if m.fastHandle(h) {
+		return BorrowedRewriteApp{&m.nodes[(h.slot-1)/astPageSize].slots[(h.slot-1)%astPageSize]}
+	}
+	return BorrowedRewriteApp{}
+}
+func (v BorrowedRewriteApp) Argument(m *ASTManager, h ASTHandle, i uint32) (ASTHandle, error) {
+	if v.slot == nil || !m.fastHandle(h) {
+		return m.GetArg(h, i)
+	}
+	if i >= v.slot.app.count {
+		return ASTHandle{}, ErrASTDomain
+	}
+	if i < astInlineArgs {
+		return m.external(v.slot.app.inlineArgs[i]), nil
+	}
+	child, e := m.appArg(&v.slot.app, i)
+	return m.external(child), e
+}
+func (v BorrowedRewriteApp) Declaration(m *ASTManager, h ASTHandle) (ASTHandle, error) {
+	if v.slot == nil || !m.fastHandle(h) {
+		return m.GetDecl(h)
+	}
+	return m.external(v.slot.app.decl), nil
+}
+func (v BorrowedRewriteApp) References(m *ASTManager, h ASTHandle) (uint32, error) {
+	if v.slot == nil || !m.fastHandle(h) {
+		return m.GetRefCount(h)
+	}
+	return v.slot.node.rc, nil
+}
+func (v BorrowedRewriteApp) IsFoldOperator(m *ASTManager, h ASTHandle, kind int32) (bool, error) {
+	if v.slot != nil && m.fastHandle(h) && v.slot.app.declCached {
+		return v.slot.app.declFamily == m.BasicFamilyID() && v.slot.app.declKind == kind, nil
+	}
+	app, f, k, err := m.AppIdentity(h)
+	return app && f == m.BasicFamilyID() && k == kind, err
+}
