+func (c *satSolverJustifications) store(i uint32, j satJustification) {
+	r := reasonWords{val1: j.val1, val2: j.val2}
+	fallback := false
+	if j.Kind() == 3 {
+		if j.val2 == 3 && j.val1 == j.locator.slot && j.locator.storageKind <= 1 && j.locator.generation < 1<<28 {
+			r.val2 |= j.locator.generation<<4 | j.locator.storageKind<<3
+		} else {
+			fallback = true
+		}
+	} else if j.locator != (satClauseOffset{}) {
+		fallback = true
+	}
+	if fallback || j.val2 == 7 {
+		if c.excess == nil {
+			c.excess = make(map[uint32]satJustification)
+		}
+		c.excess[i] = j
+		r = reasonWords{val2: 7}
+	} else if c.excess != nil {
+		delete(c.excess, i)
+	}
+	c.values[i] = r
