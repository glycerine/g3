+// Split a conjunctive invariant so the matcher can instantiate each
+// consequence independently. For a Boolean equality of two applications of
+// the same predicate, either application can trigger the forward implication.
+func (f *frameMatcher) splitInvariant(index int) {
+	t := f.t
+	q := t.terms[t.assertions[index]]
+	implication := t.terms[q.value]
+	before := t.children[implication.start]
+	conclusion := t.terms[t.children[implication.start+1]]
+	if conclusion.op != opAnd || conclusion.count < 2 || conclusion.count > 8 {
+		return
+	}
+	conjuncts := t.arguments(&conclusion)
+	booleanPair := func(id int32) bool {
+		eq := t.terms[id]
+		if eq.op != opEqual || eq.count != 2 {
+			return false
+		}
+		left, right := t.terms[t.children[eq.start]], t.terms[t.children[eq.start+1]]
+		return left.op == opFunction && left.domain == boolean && right.op == opFunction && left.value == right.value
+	}
+	applicable := false
+	for _, id := range conjuncts {
+		if !f.visit() {
+			return
+		}
+		applicable = applicable || booleanPair(id)
+	}
+	if !applicable {
+		return
+	}
+	var rules []int32
+	add := func(guard, consequence int32) {
+		q.value = f.booleanTerm(opImplies, guard, consequence)
+		rules = append(rules, int32(len(t.terms)))
+		t.terms = append(t.terms, q)
+	}
+	for _, id := range conjuncts {
+		if booleanPair(id) {
+			args := t.arguments(&t.terms[id])
+			add(f.booleanTerm(opAnd, before, args[0]), args[1])
+			add(f.booleanTerm(opAnd, before, args[1]), args[0])
+		} else {
+			add(before, id)
+		}
+	}
+	t.assertions = slices.Replace(t.assertions, index, index+1, rules...)
+}
