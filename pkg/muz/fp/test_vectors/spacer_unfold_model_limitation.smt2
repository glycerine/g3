(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.subsumption_checker false)
(set-option :fixedpoint.xform.coalesce_rules true)
(set-option :fixedpoint.xform.unfold_rules 2)
(declare-rel Leaf (Int Int))
(declare-rel Left (Int))
(declare-rel Goal ())
(declare-var x Int)
(declare-var y Int)
(rule (Leaf 0 y))
(rule (=> (and (Leaf x y) (< x 5)) (Leaf (+ x 1) y)))
(rule (=> (and (Leaf x y) (< x 1)) (Leaf (+ x 5) y)))
(rule (=> (Leaf x y) (Left x)))
(rule (=> (and (Left x) (< x 0)) Goal))
(query Goal :print-answer true)
