(set-option :fixedpoint.engine datalog)
(define-sort s () (_ BitVec 3))
(declare-rel e (s s) doc)
(declare-rel p (s s) doc)
(declare-var x s)
(declare-var y s)
(declare-var z s)
(rule (e #b001 #b010))
(rule (e #b010 #b011))
(rule (=> (e x y) (p x y)))
(rule (=> (and (p x y) (e y z)) (p x z)))
(query p :print-answer true)
