; Number theory batch 2, goal 39, with an incremental base.
(declare-fun dvds (Int Int) Bool)
(declare-fun commdiv (Int Int Int) Bool)
(declare-fun gcd (Int Int) Int)
(declare-fun c () Int)
(declare-fun b () Int)
(declare-fun a () Int)
(declare-fun _D () Int)
(declare-fun _C () Int)
(declare-fun _B_j () Int)
(declare-fun _A_g () Int)
(assert (let ((a!1 (forall ((|X:nat| Int) (|Y:nat| Int) (|Z:nat| Int))
             (= (commdiv |Z:nat| |X:nat| |Y:nat|)
                (and (dvds |Z:nat| |X:nat|) (dvds |Z:nat| |Y:nat|))))))
  (and a!1)))
(push 1)
(assert (let ((a!1 (= (ite (< (* _A_g a) (* _B_j b)) 0 (- (* _A_g a) (* _B_j b)))
              (gcd a b)))
      (a!3 (* (ite (< (* _A_g _C) (* _B_j _D)) 0 (- (* _A_g _C) (* _B_j _D))) c))
      (a!5 (forall ((|X0:nat| Int) (|X1:nat| Int))
             (=> (and (<= 0 |X0:nat|) (<= 0 |X1:nat|))
                 (not (> 0 (gcd |X0:nat| |X1:nat|)))))))
(let ((a!2 (and (and (< 0 a) (< 0 b))
                (< 0 c)
                (= (* _C c) a)
                (< 0 c)
                (= (* _D c) b)
                (=> (and (< 0 a) (< 0 b)) a!1))))
(let ((a!4 (=> a!2 (and (< 0 c) (= a!3 (gcd a b))))))
  (and (not a!4)
       (not (> 0 _A_g))
       (not (> 0 _B_j))
       (not (> 0 _C))
       (not (> 0 _D))
       (not (> 0 a))
       (not (> 0 b))
       (not (> 0 c))
       a!5)))))

(check-sat)
