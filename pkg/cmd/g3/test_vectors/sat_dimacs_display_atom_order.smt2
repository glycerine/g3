(set-option :sat.dimacs.display true)
(set-logic QF_BV)
(declare-const x (_ BitVec 3))
(declare-const y (_ BitVec 3))
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(push)
(assert (= (bvadd x y) #b111))
(assert (or p q r))
(assert (=> p (bvult x y)))
(assert (or (not r) q))
(check-sat)
