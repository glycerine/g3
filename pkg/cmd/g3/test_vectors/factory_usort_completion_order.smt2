(set-option :model.completion true)
(declare-sort U 0)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)
(declare-fun f (U) U)
(declare-fun g (U U) Bool)
(declare-const z U)
(assert (distinct a b c d e))
(assert (= (f a) b))
(assert (= (f b) c))
(assert (g c d))
(check-sat)
(get-model)
(get-value (z (f e) (f z) (g e a) (g z z)))
(eval (f d) :completion true)
(eval (f (f z)) :completion true)
