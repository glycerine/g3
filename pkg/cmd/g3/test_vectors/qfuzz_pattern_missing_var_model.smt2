(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int) (y Int)) (p 2)))
(assert (forall ((x Int) (y Int)) (! (=> (p (f 1)) (< (+ (- 1 2) (+ 2 y)) 2)) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (=> (< (g (g 1 a) (- 2 y)) (- (f y) (- 1 1))) (= (f y) (g (ite (p 1) 1 b) x)))))
(assert (<= (+ 2 (+ 1 a)) (g (+ 0 b) 1)))
(check-sat)
(get-model)
