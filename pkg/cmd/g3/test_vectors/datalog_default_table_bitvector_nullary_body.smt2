(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(declare-rel p ())
(declare-rel e ((_ BitVec 3) (_ BitVec 3)))
(declare-rel t ((_ BitVec 3) (_ BitVec 3)))
(declare-var x (_ BitVec 3))
(declare-var y (_ BitVec 3))
(declare-var z (_ BitVec 3))
(rule p)
(rule (e #b101 #b011))
(rule (e #b011 #b111))
(rule (e #b111 #b001))
(rule (e #b001 #b110))
(rule (=> (and p (e x y)) (t x y)))
(rule (=> (and (t x y) p (e y z)) (t x z)))
(query t :print-answer true)
