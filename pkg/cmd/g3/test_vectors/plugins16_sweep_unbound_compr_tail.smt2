; bv default_table=hashtable magic_sets_for_queries=true inline_linear=false inline_eager=false subsumption=false default_table_checked=true default_table_checker=hashtable all_or_nothing_deltas=true tail_simplifier_pve=false fix_unbound_vars=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table hashtable)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(set-option :fixedpoint.xform.tail_simplifier_pve false)
(set-option :fixedpoint.xform.fix_unbound_vars true)
(define-sort N () (_ BitVec 3))
(declare-rel p0 (N N))
(declare-rel p1 (N))
(declare-rel p2 (N N N))
(declare-rel p3 (N))
(declare-rel p4 (N N))
(declare-rel p5 (N N))
(declare-rel p6 (N N N))
(declare-rel p7 (N N N))
(declare-rel goal ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(declare-var u N)
(declare-var v N)
(rule (p0 #b111 #b110))
(rule (p0 #b101 #b000))
(rule (p2 #b101 #b110 #b100))
(rule (p0 #b100 #b010))
(rule (p0 #b100 #b011))
(rule (p1 #b010))
(rule (p0 #b011 #b011))
(rule (p0 #b000 #b110))
(rule (p2 #b111 #b100 #b011))
(rule (=> (and (p0 y v) (p2 y z y) (p1 z)) (p2 x v u)))
(rule (=> (and (p5 z x) (p2 u x y) (p0 u x)) (p7 v x v)))
(rule (=> (and (p2 x y v) (p6 y z x) (p0 u v)) (p6 v v x)))
(rule (=> (and (p1 y)) (p7 z x z)))
(rule (=> (and (p0 z z) (p5 v x)) (p2 y v x)))
(rule (=> (and (p6 z x z) (p3 x) (p4 u z)) (p1 x)))
(rule (=> (and (p0 x x) (p5 v z) (p3 z)) (p7 y y v)))
(rule (=> (and (p3 u)) (p6 y y u)))
(rule (=> (p6 x x u) goal))
(query goal)
