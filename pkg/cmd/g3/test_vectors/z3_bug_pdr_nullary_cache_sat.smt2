(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(declare-rel A ())
(declare-rel B ())
(declare-rel C (Int))
(declare-rel D (Int))
(declare-rel G ())
(declare-var x Int)
(rule (C 0))
(rule (=> (and (C x) (< x 3)) (C (+ x 1))))
(rule (=> (C 3) A))
(rule (D 0))
(rule (=> (and (D x) (< x 3)) (D (+ x 1))))
(rule (=> (D 3) B))
(rule (=> (and B A) G))
(query G :print-answer true)
