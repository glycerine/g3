(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(declare-const d Real)
(assert (> (* a b) 1.0))
(assert (< (+ (* b c) d) (- 2.0)))
(assert (> (+ (* c d) (* a a)) 3.0))
(assert (< (* d a b) 5.0))
(check-sat-using (using-params qfnra-nlsat :shuffle_vars true :seed 0))
(get-model)
