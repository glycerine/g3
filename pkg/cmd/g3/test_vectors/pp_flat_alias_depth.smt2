(set-option :pp.flat_assoc false)
(set-option :pp.min_alias_size 3)
(set-option :pp.max_depth 2)
(declare-fun f (Int) Int)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const i Int)
(simplify (and a (and b c)) :flat false)
(display (f (f (f (f (f i))))))
(display (let ((t (+ (f i) (f (+ i 1)) (f (+ i 2))))) (and (> t 0) (< t 100) (= (f t) t))))
