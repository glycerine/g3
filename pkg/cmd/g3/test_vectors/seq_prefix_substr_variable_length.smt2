; theory_seq::solve_unit_eq keeps the mk_concat temporary referenced while
; add_solution resets the solution-map cache.
(set-option :produce-models true)
(declare-const a Bool)
(declare-const x Int)
(declare-const s String)
(declare-const t String)
(push 1)
(assert (str.prefixof "a" (str.substr t 0 x)))
(check-sat)
(get-info :reason-unknown)
(pop 1)
(push 1)
(assert a)
(assert (str.prefixof "a" (str.substr t (str.len "") (str.len s))))
(check-sat)
(pop 1)
(push 1)
(assert (str.contains s (str.at (str.++ "a" "ab") (str.len "ab"))))
(assert (str.prefixof (str.replace s (str.at "ba" x) (str.substr "a" 0 0)) "a"))
(check-sat)
(pop 1)
