(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int))
(declare-rel q2 (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var x1 Int)
(rule (=> (= x 1) (q0 x)))
(rule (=> (and (q0 x) (= x1 (- x 2))) (q2 x1)))
(rule (=> (and (q0 x) (= x1 3)) (q0 x1)))
(rule (=> (and (q0 x) (>= x 1)) err))
(query err :print-certificate true)
