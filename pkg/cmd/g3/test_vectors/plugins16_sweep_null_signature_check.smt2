; mutual default_table=bitvector default_relation=doc check_relation=doc explanations_on_relation_level=true magic_sets_for_queries=true unbound_compressor=false inline_linear=false coi=false bit_blast=true default_table_checked=true default_table_checker=hashtable magic=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.datalog.check_relation doc)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.datalog.unbound_compressor false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.coi false)
(set-option :fixedpoint.xform.bit_blast true)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.xform.magic true)
(define-sort N () (_ BitVec 3))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b100 #b010))
(rule (e #b000 #b100))
(rule (e #b001 #b100))
(rule (e #b100 #b000))
(rule (e #b000 #b000))
(rule (e #b010 #b010))
(rule (b #b101))
(rule (n #b011))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (a x z)))
(rule (=> (and (a x y) (e y z)) (t x z)))
(rule (=> (and (a x y) (b y)) (c y x)))
(rule (=> (c x y) (a x y)))
(rule (=> (a #b010 y) q))
(query q)
