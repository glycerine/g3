(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int Int))
(declare-rel q1 (Int Int))
(declare-rel q2 (Int Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(declare-var x1 Int)
(declare-var y1 Int)
(rule (=> (and (= x 0) (= y 3)) (q0 x y)))
(rule (=> (and (q1 x y) (>= y 11) (= x1 (+ x 3)) (= y1 5)) (q0 x1 y1)))
(rule (=> (and (q0 x y) (<= y 5)) err))
(query err :print-certificate true)
