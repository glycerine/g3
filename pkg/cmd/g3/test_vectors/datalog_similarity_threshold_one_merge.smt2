(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.similarity_compressor_threshold 1)
(declare-rel P ((_ BitVec 2) (_ BitVec 2)))
(declare-rel Q ((_ BitVec 2)))
(declare-var x (_ BitVec 2))
(declare-var y (_ BitVec 2))
(declare-rel R ((_ BitVec 2)))
(rule (R #b00))
(rule (=> (R x) (P x #b01)))
(rule (=> (R x) (P x #b10)))
(rule (=> (P x y) (Q y)))
(query Q :print-answer true)
