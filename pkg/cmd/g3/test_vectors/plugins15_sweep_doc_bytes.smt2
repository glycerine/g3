; select default_table=sparse default_relation=doc magic_sets_for_queries=true similarity_compressor=false inline_linear=false inline_eager=false default_table_checker=lazy_sparse magic=true coalesce_rules=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table sparse)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.datalog.similarity_compressor false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.datalog.default_table_checker lazy_sparse)
(set-option :fixedpoint.xform.magic true)
(set-option :fixedpoint.xform.coalesce_rules true)
(define-sort N () (_ BitVec 4))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b0000 #b0000))
(rule (e #b1111 #b1010))
(rule (e #b1100 #b1001))
(rule (e #b0110 #b1100))
(rule (e #b0101 #b0100))
(rule (e #b0000 #b0000))
(rule (e #b1100 #b0100))
(rule (e #b0001 #b1100))
(rule (e #b1000 #b0100))
(rule (e #b0010 #b1110))
(rule (e #b1001 #b0000))
(rule (e #b0001 #b0001))
(rule (b #b0100))
(rule (n #b0001))
(rule (b #b1000))
(rule (n #b0011))
(rule (b #b1101))
(rule (n #b0010))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t #b0110 y) (e y z)) (t #b0110 z)))
(rule (=> (and (t x y) (b y)) (t y x)))
(rule (=> (t #b0110 #b0000) q))
(query q)
