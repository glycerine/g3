(set-option :fixedpoint.engine duality)
(declare-rel p (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(rule (=> (= x 0) (p x)))
(rule (=> (and (p x) (= y (+ x 1)) (< x 5)) (p y)))
(rule (=> (and (p x) (exists ((z Int)) (and (> z x) (< z 3)))) err))
(query err :print-certificate true)
