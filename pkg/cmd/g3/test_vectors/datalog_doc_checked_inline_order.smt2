(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.check_relation doc)
(declare-rel e ((_ BitVec 3) (_ BitVec 3)))
(declare-var x (_ BitVec 3))
(declare-var y (_ BitVec 3))
(declare-rel q ((_ BitVec 3) (_ BitVec 3)))
(rule (e #b000 #b001))
(rule (e #b001 #b010))
(rule (e #b011 #b011))
(rule (=> (e x y) (q x y)))
(query q :print-answer true)
