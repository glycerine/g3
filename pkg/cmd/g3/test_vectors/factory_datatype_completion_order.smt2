(set-option :model.completion true)
(declare-datatypes ((T 0)) (((t0) (t1 (x Int)) (t2 (l T) (r T)) (t3 (b Bool) (s T)))))
(declare-datatypes ((L 0)) (((nil) (cons (hd Int) (tl L)))))
(declare-const p T)
(declare-const q T)
(declare-const w T)
(declare-const v T)
(declare-const u T)
(declare-const m L)
(declare-const n L)
(declare-const o L)
(assert (distinct p q w v))
(assert ((_ is t2) p))
(assert ((_ is t3) q))
(assert (distinct m n o))
(assert (not ((_ is nil) m)))
(check-sat)
(get-model)
(get-value (u (l p) (r p) (s q) (x w) (tl m) (hd n) (l (l u))))
