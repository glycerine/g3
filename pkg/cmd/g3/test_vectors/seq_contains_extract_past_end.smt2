; Extractions past the end of a constant base simplify to the empty string
; before search, so these contains constraints are trivially satisfiable.
(set-option :produce-models true)
(declare-datatypes ((Lst 0)) (((nil) (cons (hd Int) (tl Lst)))))
(declare-const x Int)
(declare-const s String)
(declare-const t String)
(declare-const l Lst)
(declare-const m Lst)
(push 1)
(assert (ite (= l nil) (str.contains (str.replace "ba" "" "ba") (str.at "" 1)) true))
(assert (= l m))
(assert (str.contains (str.at (str.++ "a" "ba") 1) (str.substr (str.replace "ba" "a" "a") (+ 1 2) (str.indexof t s x))))
(check-sat)
(pop 1)
(push 1)
(assert (str.prefixof "a" t))
(assert (str.contains (str.++ (str.substr t 1 x) "ab") (str.replace (str.substr "" 2 x) "ba" (str.at s 0))))
(assert (ite true (or (<= x x) true) ((_ is nil) (tl m))))
(check-sat)
(get-value ((str.prefixof "a" t)))
(pop 1)
