(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(define-sort s () (_ BitVec 3))
(declare-rel e (s s))
(declare-rel path (s s))
(declare-rel n (s))
(declare-rel q (s))
(declare-rel g ())
(declare-var x s)
(declare-var y s)
(rule (e #b001 #b010))
(rule (e #b100 #b101))
(rule (=> (e x y) (n x)))
(rule (=> (e x y) (path x y)))
(rule (=> (and (n x) (not (path x x))) (q x)))
(rule (=> (q #b100) g))
(query g)
