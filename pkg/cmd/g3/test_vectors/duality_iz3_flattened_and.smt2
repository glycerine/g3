(set-option :fixedpoint.engine duality)
(set-option :fixedpoint.print_certificate true)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(declare-rel inv (Int Int))
(declare-rel aux (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(rule (=> (and (= x 0) (= y 5)) (inv x y)))
(rule (=> (inv x y) (aux x)))
(rule (=> (and (aux x) (inv x y) (< x 10)) (inv (+ x 1) y)))
(rule (=> (and (inv x y) (> x 10)) err))
(query err)
