(declare-datatypes ((Tree 0) (Forest 0)) (((leaf (val Int)) (node (kids Forest))) ((fnil) (fcons (head Tree) (rest Forest)))))
(declare-datatypes ((C 0)) (((red) (green) (blue))))
(declare-fun f (Tree) C)
(declare-fun g (C) Tree)
(declare-const a Tree)
(declare-const b Tree)
(declare-const c Tree)
(declare-const d Forest)
(declare-const e Forest)
(assert (distinct a b c))
(assert (distinct d e fnil))
