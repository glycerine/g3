(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (! (=> (<= (+ (ite (<= 0 2) 1 b) (f b)) (g (- x 1) (ite (p x) 0 1))) (<= (f (- a 2)) (ite (= (g 1 b) (f 1)) 0 (ite (<= 2 b) x 0)))) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (! (= a (+ 1 (- b 1))) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (! (=> (p (f a)) (<= (f (ite (= 2 b) x a)) (g (g 0 2) b))) :pattern ((f x)))))
(assert (p b))
(assert (not (not (p 0))))
(assert (< a (ite (p (f a)) 0 (- 1 a))))
(check-sat)
(get-model)
