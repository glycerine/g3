; bv default_table=lazy_sparse default_relation=doc check_relation=tr_sparse explanations_on_relation_level=true magic_sets_for_queries=true similarity_compressor=false inline_eager=false subsumption=false inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table lazy_sparse)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.datalog.check_relation tr_sparse)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.datalog.similarity_compressor false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 3))
(declare-rel p0 (N N))
(declare-rel p1 (N N N N))
(declare-rel p2 (N N))
(declare-rel p3 (N N N))
(declare-rel p4 (N N N))
(declare-rel p5 (N N))
(declare-rel goal ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(declare-var u N)
(declare-var v N)
(rule (p0 #b110 #b100))
(rule (p2 #b000 #b011))
(rule (p1 #b101 #b101 #b001 #b110))
(rule (p2 #b100 #b001))
(rule (p1 #b000 #b101 #b011 #b101))
(rule (p2 #b001 #b011))
(rule (p1 #b010 #b110 #b111 #b000))
(rule (p1 #b100 #b011 #b011 #b001))
(rule (p0 #b001 #b111))
(rule (p1 #b100 #b110 #b001 #b110))
(rule (p2 #b101 #b101))
(rule (p0 #b101 #b001))
(rule (p0 #b101 #b100))
(rule (p2 #b000 #b001))
(rule (p0 #b001 #b010))
(rule (p1 #b010 #b111 #b010 #b101))
(rule (p0 #b100 #b011))
(rule (p2 #b101 #b000))
(rule (p0 #b101 #b000))
(rule (p2 #b110 #b100))
(rule (p2 #b001 #b111))
(rule (p2 #b101 #b110))
(rule (p1 #b100 #b100 #b011 #b101))
(rule (p0 #b111 #b001))
(rule (=> (and (p5 y u) (p1 v x x v) (p0 x u) (not (p2 u x))) (p4 x x x)))
(rule (=> (and (p5 y v)) (p1 x y u u)))
(rule (=> (and (p0 v z) (p0 v x)) (p5 u v)))
(rule (=> (and (p1 u z u u)) (p1 y x u x)))
(rule (=> (and (p0 x x)) (p4 y y x)))
(rule (=> (and (p3 v u x) (p4 v u v) (= z #b010)) (p1 x y y y)))
(rule (=> (and (p5 y z) (= y #b111)) (p3 x x u)))
(rule (=> (and (p3 x u u) (p1 x z v v) (p0 x x)) (p5 x z)))
(rule (=> (and (p5 u x) (p4 u u z) (p0 u y) (not (p0 y x))) (p4 u u x)))
(rule (=> (and (p0 y y) (p5 v z) (p3 u x x)) (p4 u z v)))
(rule (=> (p4 z u v) goal))
(query goal)
