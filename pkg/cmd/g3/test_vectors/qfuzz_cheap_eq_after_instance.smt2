(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (p (ite (p (ite (p a) 1 x)) (g 1 1) 0))))
(assert (forall ((x Int) (y Int)) (! (=> (< (g x 1) x) (<= (+ (ite (p a) x a) (f y)) (ite (< (f b) a) (+ 1 1) x))) :pattern ((f x)))))
(assert (= a (+ (f 2) (+ 1 b))))
(check-sat)
(get-model)
