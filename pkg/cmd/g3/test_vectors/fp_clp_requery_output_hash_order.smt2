(set-option :fixedpoint.engine clp)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.subsumption_checker false)
(set-option :fixedpoint.xform.coalesce_rules false)
(set-option :fixedpoint.xform.scale false)
(declare-rel p (Real))
(declare-rel q (Real))
(rule (p 1.0))
(query p)
(query q)
(query p)
