(set-option :auto_config false)
(set-option :smt.pb.conflict_frequency 1000)
(set-option :smt.pb.enable_compilation false)
(set-option :smt.pb.enable_simplex true)
(set-logic ALL)
(declare-const v0 Bool)
(declare-const v1 Bool)
(declare-const v2 Bool)
(declare-const v3 Bool)
(declare-const v4 Bool)
(assert ((_ at-least 2) v2 (not v3) (not v4) v0 (not v1)))
(assert ((_ pble 9 4 5 1) (not v0) v4 v2))
(assert (not ((_ pble 10 2 2 5 4 2) v0 (not v2) v1 v4 v3)))
(assert (or (not v1) (not v0) (not v4)))
(assert (or v4 v4))
(assert (or (not v0) v3 v1))
(assert (or v3 v4))
(check-sat)
