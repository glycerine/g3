(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker bitvector)
(declare-rel q ((_ BitVec 2)))
(declare-rel r ((_ BitVec 2)))
(declare-rel e ((_ BitVec 4) (_ BitVec 4)))
(declare-rel t ((_ BitVec 4) (_ BitVec 4)))
(declare-var x (_ BitVec 2))
(declare-var a (_ BitVec 4))
(declare-var b (_ BitVec 4))
(declare-var c (_ BitVec 4))
(rule (q #b10))
(rule (q #b01))
(rule (=> (q x) (r x)))
(rule (e #x9 #x3))
(rule (e #x3 #x7))
(rule (e #x7 #x1))
(rule (=> (e a b) (t a b)))
(rule (=> (and (t a b) (e b c)) (t a c)))
(query r :print-answer true)
(query t :print-answer true)
