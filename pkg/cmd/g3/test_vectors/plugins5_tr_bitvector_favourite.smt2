(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation tr_bitvector)
(declare-rel e ((_ BitVec 20) (_ BitVec 20)))
(declare-rel w ((_ BitVec 3)))
(declare-rel t ((_ BitVec 20) (_ BitVec 20)))
(declare-rel n ())
(declare-rel m ((_ BitVec 3)))
(declare-var x (_ BitVec 20))
(declare-var y (_ BitVec 20))
(declare-var z (_ BitVec 20))
(declare-var u (_ BitVec 3))
(rule (e #x00001 #x00002))
(rule (e #x00002 #x00003))
(rule (e #x00009 #x00001))
(rule (w #b001))
(rule (w #b110))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (and (w u) (not (= u #b001))) n))
(rule (=> (and (w u) (not n)) (m u)))
(rule (=> (and (w u) n) (m (bvadd u #b001))))
(query t :print-answer true)
(query m :print-answer true)
(query n :print-answer true)
