(declare-const u (_ BitVec 8))
(declare-const v (_ BitVec 8))
(declare-const p Bool)
(assert (bvult u (bvadd v #x03)))
(assert (= p (= ((_ extract 3 0) u) #x5)))
(assert (or p (bvsgt v #x10)))
(assert (distinct u v))
(apply horn)
(check-sat-using horn)
(apply horn-simplify)
(check-sat-using horn-simplify)
