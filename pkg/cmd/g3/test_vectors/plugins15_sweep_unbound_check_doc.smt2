; strata default_relation=doc check_relation=tr_check explanations_on_relation_level=true magic_sets_for_queries=true inline_linear=false compress_unbound=false coi=false subsumption=false karr=true unfold_rules=1 inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.datalog.check_relation tr_check)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.xform.coi false)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.xform.karr true)
(set-option :fixedpoint.xform.unfold_rules 1)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 3))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b110 #b101))
(rule (e #b010 #b001))
(rule (e #b010 #b000))
(rule (e #b011 #b111))
(rule (e #b100 #b100))
(rule (e #b111 #b010))
(rule (b #b000))
(rule (n #b111))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (and (b x) (not (t x #b110))) (s x)))
(rule (=> (and (s x) (e x y)) (a x y)))
(rule (=> (and (a x y) (a y z)) (a x z)))
(rule (=> (and (a x y) (not (b y))) (r y)))
(rule (=> (r #b101) q))
(query q)
