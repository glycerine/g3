(set-option :fixedpoint.engine datalog)
(declare-rel p (Int Bool))
(declare-rel r (Bool))
(declare-rel s (Bool Bool))
(declare-var x Int)
(declare-var b Bool)
(declare-var c Bool)
(rule (r true))
(rule (=> (and (r b) (not (p x b))) (r false)))
(rule (=> (and (r b) (r c) (not (p x c))) (s b c)))
(query s :print-answer true)
