(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (=> (< 2 (+ x 2)) (p 1))))
(assert (forall ((x Int) (y Int)) (! (p 0) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (! (<= (ite (not (<= a 0)) 1 (+ b x)) (- (ite (<= 1 2) b 2) (+ x b))) :pattern ((f x)))))
(assert (< 1 (f (g a 2))))
(check-sat)
