(set-option :fixedpoint.engine datalog)
(declare-rel a () tr_bitvector)
(declare-rel w ((_ BitVec 20) (_ BitVec 20)) tr_bitvector)
(declare-rel b ((_ BitVec 2)))
(declare-var x (_ BitVec 2))
(declare-var y (_ BitVec 20))
(rule (b #b01))
(rule (w #x00001 #x00002))
(rule (=> (b x) a))
(rule (=> (and a (w y y)) a))
(query a :print-answer true)
(query w :print-answer true)
