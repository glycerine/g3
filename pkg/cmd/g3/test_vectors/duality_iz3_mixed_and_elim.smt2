(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int))
(declare-rel q1 (Int))
(declare-rel q2 (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var x1 Int)
(rule (=> (and (= x 2)) (q0 x)))
(rule (=> (and (q0 x) (= x 7) (= x1 (+ x 2))) (q2 x1)))
(rule (=> (and (q0 x) (< x 5) (= x1 x)) (q1 x1)))
(rule (=> (and (q1 x) (>= x 1) (= x1 (+ x 3))) (q1 x1)))
(rule (=> (and (q1 x) (<= x (+ x 1)) (= x1 (- x 3)) (q0 x)) (q1 x1)))
(rule (=> (and (q2 x) (> x (- x 2))) err))
(query err :print-certificate true)
