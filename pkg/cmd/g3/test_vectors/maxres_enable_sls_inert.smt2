(set-option :opt.enable_sls true)
(set-option :produce-models true)
(declare-const p0 Bool)
(declare-const p1 Bool)
(declare-const p2 Bool)
(declare-const p3 Bool)
(declare-const p4 Bool)
(declare-const p5 Bool)
(declare-const p6 Bool)
(declare-const p7 Bool)
(declare-const x Int)(declare-const y Int)
(assert (<= 0 x 20))(assert (<= 0 y 20))
(assert (or (not p5) p1 (not p3)))
(assert (or (not p5) p4 p0))
(assert (or p6 p0 (not p1)))
(assert (or (not p1) (not p7) (not p5)))
(assert (or p6 (not p0) p1))
(assert (or (not p2) (not p4) (not p0)))
(assert (or (not p1) p4 (not p6)))
(assert (or (not p1) p4 (not p0)))
(assert (or (not p5) p3 p4))
(assert (or p2 p5 p1))
(assert (=> p0 (> (+ x y) 15)))
(assert (=> p4 (< x 14)))
(assert (=> p1 (> (+ x y) 14)))
(assert (=> p5 (< x 2)))
(assert (=> p2 (> (+ x y) 8)))
(assert (=> p6 (< x 13)))
(assert (=> p3 (> (+ x y) 10)))
(assert (=> p7 (< x 10)))
(assert-soft (not p0) :weight 2)
(assert-soft p1 :weight 5)
(assert-soft (not p2) :weight 1)
(assert-soft p3 :weight 3)
(assert-soft p4 :weight 3)
(assert-soft p5 :weight 5)
(assert-soft (not p6) :weight 1)
(assert-soft p7 :weight 5)
(check-sat)(get-objectives)(get-model)
