(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(declare-const z (_ BitVec 8))
(declare-const p Bool)
(assert (= (bvmul x y) #xa5))
(assert (= (bvadd y z) #x13))
(assert (bvult x #x40))
(assert (or p (= (bvand x z) #x01)))
(assert (not p))
(check-sat-using (using-params qfbv-sls :sls.restart_base 3 :sls.max_restarts 6 :sls.restart_init true :sls.walksat_repick false))
