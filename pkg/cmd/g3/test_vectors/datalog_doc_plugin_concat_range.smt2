(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(declare-rel e ((_ BitVec 4) (_ BitVec 4)))
(declare-rel q ((_ BitVec 8)))
(declare-rel w ((_ BitVec 4)))
(declare-var x (_ BitVec 4))
(declare-var y (_ BitVec 4))
(declare-var z (_ BitVec 8))
(rule (e #x1 #x2))
(rule (e #x3 #x4))
(rule (=> (and (e x y) (= z (concat x y))) (q z)))
(rule (=> (and (e x y) (bvule y #x3)) (w x)))
(rule (=> (and (e x #x4)) (w x)))
(query q :print-answer true)
(query w :print-answer true)
