(set-option :smt.string_solver z3str3)
(declare-const x String)
(push 1)
(assert (str.in.re x (re.inter (str.to.re "a") (str.to.re "b"))))
(check-sat)
(pop 1)
(push 1)
(assert (str.in.re x (re.inter (re.* (str.to.re "a")) (re.* (str.to.re "b")))))
(check-sat)
(pop 1)
(push 1)
(assert (str.in.re (str.++ x "a") (re.inter (re.+ (str.to.re "a")) (re.+ (str.to.re "b")))))
(check-sat)
(pop 1)
