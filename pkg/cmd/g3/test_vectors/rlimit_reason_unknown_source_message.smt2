(set-option :smt.auto_config false)
(set-option :smt.mbqi true)
(set-option :rlimit 500)
(declare-sort U 0)
(declare-fun f (U) U)
(declare-fun g (U U) U)
(declare-fun p (U) Bool)
(declare-fun q (U U) Bool)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(assert (forall ((x U)) (=> (p x) (p (f x)))))
(assert (forall ((x U) (y U)) (=> (q x y) (q (f x) (g x y)))))
(assert (forall ((x U) (y U)) (=> (and (p x) (p y)) (q x y))))
(assert (p a))
(assert (p (f (f (f (f (f (f (g a (g b (f (f (f c)))))))))))))
(assert (not (p b)))
(assert (not (q c (f (f (f (f (g a (f (f b))))))))))
(check-sat-using smt)
(get-info :reason-unknown)
(set-option :rlimit 5000)
(check-sat-using smt)
(get-info :reason-unknown)
