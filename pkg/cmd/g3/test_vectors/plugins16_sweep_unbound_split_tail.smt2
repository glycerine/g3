; bv default_table=hashtable magic_sets_for_queries=true subsumption=false bit_blast=true default_table_checker=hashtable all_or_nothing_deltas=true karr=true subsumption_checker=false coalesce_rules=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table hashtable)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.xform.bit_blast true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(set-option :fixedpoint.xform.karr true)
(set-option :fixedpoint.xform.subsumption_checker false)
(set-option :fixedpoint.xform.coalesce_rules true)
(define-sort N () (_ BitVec 3))
(declare-rel p0 (N N))
(declare-rel p1 (N N))
(declare-rel p2 (N))
(declare-rel p3 (N N))
(declare-rel p4 (N N N))
(declare-rel p5 (N N N))
(declare-rel p6 (N N N N))
(declare-rel goal ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(declare-var u N)
(declare-var v N)
(rule (p2 #b011))
(rule (p1 #b111 #b001))
(rule (p0 #b110 #b010))
(rule (p1 #b101 #b010))
(rule (p0 #b110 #b101))
(rule (p2 #b010))
(rule (p0 #b001 #b110))
(rule (p0 #b101 #b101))
(rule (p0 #b110 #b101))
(rule (p0 #b011 #b001))
(rule (p2 #b000))
(rule (p1 #b010 #b100))
(rule (p1 #b001 #b000))
(rule (p0 #b001 #b011))
(rule (p0 #b101 #b011))
(rule (p1 #b010 #b000))
(rule (p1 #b111 #b100))
(rule (p2 #b000))
(rule (p1 #b111 #b101))
(rule (=> (and (p6 u x v y) (p0 v z) (p1 y x)) (p1 z x)))
(rule (=> (and (p4 v v u)) (p6 z z u y)))
(rule (=> (and (p1 z z) (not (p2 y))) (p6 v x z u)))
(rule (=> (and (p4 u y z) (p1 u v) (p2 x)) (p3 z u)))
(rule (=> (and (p1 x z)) (p1 y y)))
(rule (=> (and (p2 v)) (p6 z u y v)))
(rule (=> (and (p4 v u v)) (p1 u z)))
(rule (=> (and (p5 u x x) (p6 u x x u)) (p3 x x)))
(rule (=> (and (p4 z v v)) (p6 u y u y)))
(rule (=> (and (p0 y x) (p4 v y y) (p0 y x)) (p4 y z u)))
(rule (=> (and (p2 z) (p0 v z)) (p5 y x v)))
(rule (=> (p3 u x) goal))
(query goal)
