(set-option :produce-proofs true)
(set-logic QF_UFLIA)
(declare-fun f (Int) Int)
(declare-const x Int)
(declare-const y Int)
(declare-const p Bool)
(assert (or (not p) (<= y 5)))
(assert (or (not p) (>= y 5)))
(assert (or (not p) (<= x 5)))
(assert (or (not p) (>= x 5)))
(assert (or (not p) (not (= (f x) (f y)))))
(assert (or p (<= y 6)))
(assert (or p (>= y 6)))
(assert (or p (<= x 6)))
(assert (or p (>= x 6)))
(assert (or p (not (= (f y) (f x)))))
(check-sat)
(get-proof)
