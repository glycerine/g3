; bv default_table=bitvector check_relation=doc unbound_compressor=false compress_unbound=false subsumption=false default_table_checker=sparse all_or_nothing_deltas=true coalesce_rules=true fix_unbound_vars=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.check_relation doc)
(set-option :fixedpoint.datalog.unbound_compressor false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.datalog.default_table_checker sparse)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(set-option :fixedpoint.xform.coalesce_rules true)
(set-option :fixedpoint.xform.fix_unbound_vars true)
(define-sort N () (_ BitVec 6))
(declare-rel p0 (N N))
(declare-rel p1 (N N))
(declare-rel p2 (N N N))
(declare-rel p3 (N))
(declare-rel p4 (N N N N))
(declare-rel p5 (N N))
(declare-rel p6 (N N N N))
(declare-rel p7 (N N))
(declare-rel goal ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(declare-var u N)
(declare-var v N)
(rule (p0 #b010101 #b000111))
(rule (p2 #b110001 #b001011 #b010100))
(rule (p2 #b111110 #b111010 #b111111))
(rule (p1 #b111000 #b110100))
(rule (p2 #b100011 #b011001 #b111101))
(rule (p1 #b001001 #b111000))
(rule (p2 #b100000 #b011000 #b001010))
(rule (p2 #b001111 #b100011 #b100001))
(rule (p2 #b101110 #b100000 #b001100))
(rule (p2 #b001101 #b001011 #b110011))
(rule (p2 #b010111 #b101111 #b011011))
(rule (p1 #b100111 #b011001))
(rule (p1 #b000110 #b000111))
(rule (p0 #b110100 #b010111))
(rule (p0 #b011011 #b111010))
(rule (=> (and (p1 u z)) (p6 z z x z)))
(rule (=> (and (p3 v) (p1 u v) (p3 u)) (p1 y v)))
(rule (=> (and (p5 v v) (p3 z) (p1 y v)) (p5 v x)))
(rule (=> (and (p6 z x v x) (p0 v v) (p1 x z)) (p3 z)))
(rule (=> (and (p5 y z) (p0 v v) (p5 y x)) (p6 x u v x)))
(rule (=> (and (p3 z) (p4 y z z v)) (p3 u)))
(rule (=> (and (p0 y z)) (p1 x u)))
(rule (=> (and (p0 z v) (p0 u x) (p2 x y y)) (p7 z z)))
(rule (=> (and (p7 u x) (= x #b001101)) (p6 x z y y)))
(rule (=> (and (p4 v u u y) (p2 x z u) (p4 y z z v)) (p1 v v)))
(rule (=> (and (p2 v v v) (p4 z x v u) (p1 x z)) (p6 x x z v)))
(rule (=> (and (p5 y v) (p4 v x y v) (p3 x)) (p1 y x)))
(rule (=> (and (p2 x x v) (p6 x u z z) (p6 x y x x)) (p4 v y y u)))
(rule (=> (and (p7 v x) (p0 x u) (p4 y u x x)) (p5 z u)))
(rule (=> (and (p7 x x)) (p6 z v u z)))
(rule (=> (and (p7 y z) (= z #b100101)) (p1 u v)))
(rule (=> (p4 y u u v) goal))
(query goal)
