(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.print_boogie_certificate true)
(declare-rel inv (Int))
(declare-rel err ())
(declare-var x Int)
(rule (=> (= x 0) (inv x)))
(rule (=> (and (inv x) (< x 3)) (inv (+ x 1))))
(rule (=> (and (inv x) (= x 2)) err))
(query err :print-certificate true)
