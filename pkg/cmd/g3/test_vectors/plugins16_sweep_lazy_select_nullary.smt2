; negation default_table=hashtable check_relation=tr_lazy_sparse explanations_on_relation_level=true inline_eager=false compress_unbound=false default_table_checked=true default_table_checker=hashtable magic=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table hashtable)
(set-option :fixedpoint.datalog.check_relation tr_lazy_sparse)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.xform.magic true)
(define-sort N () (_ BitVec 4))
(declare-rel e (N N))
