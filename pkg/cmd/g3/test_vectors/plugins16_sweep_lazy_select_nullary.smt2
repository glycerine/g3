(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b0101 #b0010))
(rule (e #b1111 #b0110))
(rule (e #b1001 #b0001))
(rule (e #b1000 #b1110))
(rule (e #b0000 #b0111))
(rule (e #b0101 #b0100))
(rule (e #b1101 #b1011))
(rule (e #b0101 #b1111))
(rule (e #b1110 #b1010))
(rule (e #b0010 #b0011))
(rule (e #b1100 #b0001))
(rule (e #b1011 #b0011))
(rule (b #b0110))
(rule (n #b1110))
(rule (b #b1101))
(rule (n #b1101))
(rule (b #b0110))
(rule (n #b0001))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (and (n x) (not (t x x))) (r x)))
(rule (=> (r #b1100) q))
(query q)
