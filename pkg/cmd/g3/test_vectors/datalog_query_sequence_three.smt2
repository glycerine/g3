(set-option :fixedpoint.engine datalog)
(define-sort S () (_ BitVec 4))
(declare-rel edge (S S))
(declare-rel path (S S))
(declare-rel tri (S S S))
(declare-rel same (S S))
(declare-rel nopath (S S))
(declare-rel q1 ())
(declare-rel q2 (S))
(declare-var a S) (declare-var b S) (declare-var c S) (declare-var d S)
(rule (edge #x1 #x2)) (rule (edge #x2 #x3)) (rule (edge #x3 #x1)) (rule (edge #x3 #x4))
(rule (edge #x4 #x5)) (rule (edge #x5 #x5)) (rule (edge #x6 #x7))
(rule (=> (edge a b) (path a b)))
(rule (=> (and (path a b) (edge b c)) (path a c)))
(rule (=> (and (path a b) (path b c) (path c a)) (tri a b c)))
(rule (=> (and (path a b) (path b a) (bvult a b)) (same a b)))
(rule (=> (and (edge a b) (edge c d) (= a c) (not (path b d))) (nopath b d)))
(rule (=> (and (tri a b c) (same a b) (bvugt c #x0)) q1))
(rule (=> (and (path a a) (not (same a #x1))) (q2 a)))
(query q1 :print-answer true)
(query q2 :print-answer true)
(query nopath :print-answer true)
