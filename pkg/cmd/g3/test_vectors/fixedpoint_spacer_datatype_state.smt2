(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-logic HORN)
(declare-datatypes () ((State (state (counter Int) (finished Bool)))))
(declare-rel Inv (State))
(declare-rel Bad ())
(declare-rel Reach ())
(declare-var s State)
(rule (Inv (state 0 false)))
(rule (=> (and (Inv s) (not (finished s))) (Inv (state 1 true))))
(rule (=> (and (Inv s) (> (counter s) 1)) Bad))
(rule (=> (Inv (state 1 true)) Reach))
(query Bad)
(query Reach)
(query Bad)
