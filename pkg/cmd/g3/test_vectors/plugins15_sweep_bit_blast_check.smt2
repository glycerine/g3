(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.xform.bit_blast true)
(set-option :fixedpoint.datalog.check_relation tr_sparse)
(define-sort N () (_ BitVec 2))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b01 #b10))
(rule (e #b10 #b11))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (t #b01 #b11) q))
(query q)
