; mutual default_table=bitvector check_relation=tr_check inline_eager=false compress_unbound=false bit_blast=true default_table_checked=true default_table_checker=lazy_sparse magic=true karr=true inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.check_relation tr_check)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.xform.bit_blast true)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker lazy_sparse)
(set-option :fixedpoint.xform.magic true)
(set-option :fixedpoint.xform.karr true)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 3))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b110 #b010))
(rule (e #b010 #b011))
(rule (e #b110 #b100))
(rule (b #b001))
(rule (n #b000))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (a x z)))
(rule (=> (and (a x y) (e y z)) (t x z)))
(rule (=> (and (a x y) (b y)) (c y x)))
(rule (=> (c x y) (a x y)))
(rule (=> (a #b110 y) q))
(query q)
