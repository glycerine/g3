; linear default_table=lazy_sparse check_relation=tr_hashtable unbound_compressor=false inline_eager=false compress_unbound=false subsumption=false bit_blast=true default_table_checker=hashtable subsumption_checker=false coalesce_rules=true tail_simplifier_pve=false inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table lazy_sparse)
(set-option :fixedpoint.datalog.check_relation tr_hashtable)
(set-option :fixedpoint.datalog.unbound_compressor false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.xform.bit_blast true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.xform.subsumption_checker false)
(set-option :fixedpoint.xform.coalesce_rules true)
(set-option :fixedpoint.xform.tail_simplifier_pve false)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 3))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b011 #b101))
(rule (e #b001 #b011))
(rule (e #b110 #b011))
(rule (e #b111 #b001))
(rule (e #b110 #b100))
(rule (e #b111 #b000))
(rule (e #b101 #b110))
(rule (e #b100 #b000))
(rule (e #b010 #b011))
(rule (e #b101 #b010))
(rule (e #b101 #b110))
(rule (e #b011 #b100))
(rule (b #b001))
(rule (n #b110))
(rule (b #b101))
(rule (n #b111))
(rule (b #b011))
(rule (n #b001))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (t #b000 #b001) q))
(query q)
