(declare-fun f (Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (! (=> (p x) (> (f x) x)) :pattern ((p x)))))
(assert (forall ((x Int) (y Int)) (=> (and (> x 0) (> y x)) (> (f y) (f x)))))
(assert (exists ((z Int)) (and (p z) (< z a))))
(assert (and (p a) (= (f b) (+ a 2)) (> b 0)))
(apply pb-preprocess)
(check-sat-using pb-preprocess)
