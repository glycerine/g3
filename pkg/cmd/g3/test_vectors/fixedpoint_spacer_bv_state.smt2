(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-logic HORN)
(declare-rel Inv ((_ BitVec 4)))
(declare-rel Bad ())
(declare-rel Reach ())
(declare-var x (_ BitVec 4))
(rule (Inv #x0))
(rule (=> (and (Inv x) (bvult x #x3)) (Inv (bvadd x #x1))))
(rule (=> (and (Inv x) (bvugt x #x3)) Bad))
(rule (=> (Inv #x3) Reach))
(query Bad)
(query Reach)
(query Bad)
