(set-option :fixedpoint.xform.coi false)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(set-option :fixedpoint.xform.karr true)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 4))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b1010 #b1001))
(rule (e #b0111 #b1011))
(rule (e #b0100 #b0010))
(rule (e #b0110 #b0001))
(rule (e #b0101 #b1011))
(rule (e #b1101 #b1000))
(rule (e #b0110 #b0101))
(rule (e #b0110 #b1100))
(rule (e #b0101 #b0101))
(rule (e #b0111 #b1110))
(rule (e #b0100 #b1001))
(rule (e #b1010 #b0101))
(rule (b #b1010))
(rule (n #b1001))
(rule (b #b0111))
(rule (n #b0110))
(rule (b #b0101))
(rule (n #b1001))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (a x z)))
(rule (=> (and (a x y) (e y z)) (c x z)))
(rule (=> (and (c x y) (e y z)) (t x z)))
(rule (=> (and (c x y) (n y)) q))
(query q)
