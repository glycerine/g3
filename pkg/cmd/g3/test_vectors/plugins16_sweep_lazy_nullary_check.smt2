; chain3 default_table=bitvector check_relation=tr_lazy_sparse unbound_compressor=false inline_linear=false inline_eager=false coi=false default_table_checked=true default_table_checker=hashtable all_or_nothing_deltas=true karr=true inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.check_relation tr_lazy_sparse)
(set-option :fixedpoint.datalog.unbound_compressor false)
(set-option :fixedpoint.xform.inline_linear false)
