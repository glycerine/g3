(set-logic QF_S)
(declare-const p0 Bool)
(declare-const p1 Bool)
(declare-const p2 Bool)
(declare-const x0 Int)
(declare-const x1 Int)
(declare-const x2 Int)
(declare-const s0 String)
(declare-const s1 String)
(assert (or (> 100 x2) (= "a" "abc") (str.suffixof s0 "") (=> p1 p0)))
(assert (str.contains "" (str.replace (str.++ s0 s1) (str.++ "a" "b") (str.++ s0 s1))))
(assert (distinct x2 2))
(assert (str.prefixof (ite p2 (str.substr s0 (+ x0 x0) (rem x2 15)) (str.++ (str.at s1 x1) (str.at "ab" x1))) (ite (or p2 (<= x1 0) (or p1 p2 p2) (= p1 p2)) (str.++ "a" (str.++ "ba" s0)) (str.at "" (* 1 x2)))))
(assert (=> (not (str.suffixof s1 (str.++ s1 s1))) p1))
(assert (< (abs (+ x0 x1 (abs x2))) (- (+ (+ x1 x0 x2) (- x0)) (+ (abs 100) (* 0 x2) (- x1)) 2)))
(check-sat)
(get-model)
