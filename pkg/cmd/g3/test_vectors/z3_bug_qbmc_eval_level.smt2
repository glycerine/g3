(set-option :fixedpoint.engine qbmc)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.print_answer true)
(declare-rel p (Int))
(declare-rel q ())
(declare-var x Int)
(declare-var y Int)
(rule (p 0))
(rule (=> (and (p x) (= y (+ x 1))) (p y)))
(rule (=> (and (p x) (> x 2)) q))
(query q)
