(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation tr_hashtable)
(set-option :fixedpoint.datalog.default_table sparse)
(declare-rel e ((_ BitVec 3) (_ BitVec 3)))
(declare-rel t ((_ BitVec 3) (_ BitVec 3)))
(declare-var x (_ BitVec 3))
(declare-var y (_ BitVec 3))
(declare-var z (_ BitVec 3))
(rule (e #b001 #b010))
(rule (e #b010 #b011))
(rule (e #b011 #b100))
(rule (e #b110 #b001))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(query t :print-answer true)
