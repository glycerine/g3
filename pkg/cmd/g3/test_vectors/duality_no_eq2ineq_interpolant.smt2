(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(declare-var x1 Int)
(declare-var y1 Int)
(rule (=> (and (= x 3) (= y 1)) (q0 x y)))
(rule (=> (and (q0 x y) (>= y 10) (= x1 (+ x 3)) (= y1 (+ y 3))) (q0 x1 y1)))
(rule (=> (and (q0 x y) (>= y 9) (= x1 y) (= y1 x)) (q0 x1 y1)))
(rule (=> (and (q0 x y) (>= y (- y 1)) (= x1 (- x 3)) (= y1 4)) (q0 x1 y1)))
(rule (=> (and (q0 x y) (>= y 10) (= x1 (+ x 2)) (= y1 (+ x x))) (q0 x1 y1)))
(rule (=> (and (q0 x y) (>= x 11)) err))
(query err :print-certificate true)
