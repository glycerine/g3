(set-option :fixedpoint.pdr.use_multicore_generalizer true)
(set-option :fixedpoint.engine pdr)
(set-logic HORN)
(declare-rel Inv (Int))
(declare-rel Bad ())
(declare-var x Int)
(rule (Inv 0))
(rule (=> (and (Inv x) (< x 10)) (Inv (+ x 1))))
(rule (=> (and (Inv x) (> x 10)) Bad))
(query Bad :print-answer false)
