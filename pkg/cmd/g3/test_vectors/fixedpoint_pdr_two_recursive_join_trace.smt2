(set-option :fixedpoint.engine pdr)
(declare-rel P (Int))
(declare-rel Q (Int))
(declare-rel Goal ())
(declare-var x Int)
(declare-var y Int)
(rule (P 0))
(rule (=> (and (P x) (< x 3)) (P (+ x 1))))
(rule (Q 10))
(rule (=> (and (Q y) (< y 12)) (Q (+ y 1))))
(rule (=> (and (P 3) (Q 12)) Goal))
(query Goal :print-answer true)
