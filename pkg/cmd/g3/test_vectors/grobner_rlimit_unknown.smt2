(set-option :rlimit 3000)
(declare-const x Real)
(declare-const y Real)
(declare-const z Real)
(declare-const w Real)
(assert (= (* x y) (+ z 1)))
(assert (= (* y z) (+ w 2)))
(assert (= (* z w) (+ x 3)))
(assert (= (* w x) (+ y 4)))
(assert (= (* x z) (- y w)))
(assert (> (* x x) (+ (* y y) 1)))
(check-sat-using smt)
