(set-option :produce-models true)
(declare-const a Bool)
(declare-const b Bool)
(declare-const x Int)
(declare-const y Int)
(assert (<= x 5))
(assert (=> a (< x 3)))
(assert (=> b (> x 1)))
(minimize (- x))
(maximize y)
(assert-soft a :weight 2 :id q)
(assert-soft (not b) :weight 3 :id r)
(check-sat)
(get-objectives)
