(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.pdr.cache_mode 5)
(declare-rel inv (Int))
(declare-rel err ())
(declare-var x Int)
(rule (inv 0))
(rule (=> (and (inv x) (< x 5)) (inv (+ x 1))))
(rule (=> (and (inv x) (> x 3)) err))
(query err)
(query inv)
(rule (=> (and (inv x) (> x 10)) err))
