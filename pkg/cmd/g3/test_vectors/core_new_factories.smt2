(set-logic ALL)
(declare-const p Bool)
(declare-const q Bool)
(declare-fun f (Int) Int)
(push)
(assert (= (f (ite p 1 2)) 3))
(check-sat-using (then blast-term-ite smt))
(pop)
(push)
(assert (= (+ (ite p 1 2) 3) 4))
(check-sat-using (then cofactor-term-ite smt))
(pop)
(push)
(assert ((_ at-least 1) p q))
(check-sat-using (then pb-preprocess smt))
(pop)
