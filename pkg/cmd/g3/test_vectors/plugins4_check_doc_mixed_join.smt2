(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.check_relation doc)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(declare-rel p (Bool))
(declare-rel q ((_ BitVec 3)))
(declare-rel r ((_ BitVec 3)))
(declare-var x Bool)
(declare-var y (_ BitVec 3))
(rule (p true))
(rule (q #b101))
(rule (=> (and (p x) (q y)) (r y)))
(query r :print-answer true)
