(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (! (=> (p a) (< (f (ite (<= x b) 2 a)) (+ (g b x) (+ 0 b)))) :pattern ((f x)))))
(assert (forall ((x Int)) (! (=> (= (- (ite (<= x b) 0 a) (f 1)) a) (<= (g a 2) (g (f a) (g 2 b)))) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (=> (< (ite (< x (g 2 1)) x b) (f (ite (<= y a) y y))) (p (+ (g 2 1) (ite (= b x) 0 y))))))
(assert (<= 0 (+ (g b b) 1)))
(assert (= (g (- b 2) (+ 2 b)) 0))
(assert (<= b (ite (not (= a a)) (- a b) (ite (p a) 1 a))))
(check-sat)
(get-model)
