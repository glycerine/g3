(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation bound_relation)
(declare-rel q (Int))
(declare-rel r ((_ BitVec 2)) tr_sparse)
(declare-rel t ((_ BitVec 2)))
(declare-var x Int)
(declare-var y (_ BitVec 2))
(rule (r #b01))
(rule (r #b10))
(rule (=> (and (q x) (r y)) (t y)))
(rule (=> (r y) (t y)))
(query t :print-answer true)
(query r :print-answer true)
