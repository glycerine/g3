(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int) (y Int)) (! (=> (< 2 0) (< 0 (ite (= (f 1) x) (+ 2 a) (f b)))) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (! (=> (= (- (g 1 0) (- x y)) (g (f y) (- 2 y))) (p y)) :pattern ((f x)))))
(assert (not (<= (ite (< a a) 2 2) (ite (= b 0) a 2))))
(assert (< a (ite (< (+ a b) (ite (= a 0) b 1)) (ite (< 0 0) 0 2) (- 2 0))))
(check-sat)
(get-model)
