(set-logic QF_ALIA)
(declare-const a (Array Int Int))
(declare-const b (Array Int Int))
(declare-const i0 Int)
(declare-const i1 Int)
(declare-const i2 Int)
(declare-const i3 Int)
(declare-const i4 Int)
(assert (or (not (= a (store b i3 i2)))))
(assert (or (= (store b i0 i4) (store (store a i3 i2) i3 i2))))
(assert (or (not (= (select (store (store b i3 i3) i2 i1) i0) i0)) (= (select a i4) i1)))
(assert (or (not (= (select (store b i1 i3) i4) i1))))
(assert (or (not (= (select (store (store b i1 i1) i2 i1) i3) i3)) (not (= a b))))
(check-sat)
