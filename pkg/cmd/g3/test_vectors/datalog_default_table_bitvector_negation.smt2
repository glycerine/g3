(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(declare-rel e ((_ BitVec 4) (_ BitVec 4)))
(declare-rel n ((_ BitVec 4)))
(declare-rel t ((_ BitVec 4) (_ BitVec 4)))
(declare-rel u ((_ BitVec 4) (_ BitVec 4)))
(declare-var x (_ BitVec 4))
(declare-var y (_ BitVec 4))
(declare-var z (_ BitVec 4))
(rule (e #x9 #x3))
(rule (e #x3 #x7))
(rule (e #x7 #x1))
(rule (e #x1 #xc))
(rule (e #xc #x5))
(rule (n #x7))
(rule (n #x1))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (and (t x y) (not (n y)) (bvult x y)) (u y x)))
(query u :print-answer true)
