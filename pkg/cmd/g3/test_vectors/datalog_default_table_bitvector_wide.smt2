(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(declare-rel e ((_ BitVec 16) (_ BitVec 16)))
(declare-rel t ((_ BitVec 16) (_ BitVec 16)))
(declare-var x (_ BitVec 16))
(declare-var y (_ BitVec 16))
(declare-var z (_ BitVec 16))
(rule (e #x0009 #x0003))
(rule (e #x0003 #x0107))
(rule (e #x0107 #x0001))
(rule (e #x0001 #x000c))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(query t :print-answer true)
