(declare-const x Int)
(declare-const y Real)
(declare-const p Bool)
(declare-const q Bool)
(declare-const v (_ BitVec 4))
(assert (> x 5))
(assert (< x 3))
(maximize x)
(minimize (+ y 1.5))
(assert-soft p :weight 2 :id a)
(assert-soft q :weight 3 :id b)
(assert-soft (not p) :weight 1.5 :id a)
(assert-soft false :weight 2 :id c)
(assert-soft q :weight -2 :id d)
(maximize v)
(minimize v)
(maximize (ite p 1 0))
(minimize (+ (ite q 2 0) 7))
(check-sat)
(get-objectives)
