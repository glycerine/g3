(set-option :fixedpoint.engine duality)
(declare-fun f (Int) Int)
(declare-rel p (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(assert (forall ((z Int)) (= (f z) (+ z 2))))
(rule (=> (= x 0) (p x)))
(rule (=> (and (p x) (= y (f x)) (< x 5)) (p y)))
(rule (=> (and (p x) (= x 4)) err))
(query err :print-certificate true)
