; mutual default_table=bitvector check_relation=tr_hashtable similarity_compressor=false compress_unbound=false coi=false default_table_checked=true default_table_checker=hashtable all_or_nothing_deltas=true karr=true unfold_rules=1 tail_simplifier_pve=false fix_unbound_vars=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.check_relation tr_hashtable)
(set-option :fixedpoint.datalog.similarity_compressor false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.xform.coi false)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(set-option :fixedpoint.xform.karr true)
(set-option :fixedpoint.xform.unfold_rules 1)
(set-option :fixedpoint.xform.tail_simplifier_pve false)
(set-option :fixedpoint.xform.fix_unbound_vars true)
(define-sort N () (_ BitVec 2))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b11 #b10))
(rule (e #b01 #b10))
(rule (e #b11 #b00))
(rule (e #b11 #b00))
(rule (e #b00 #b10))
(rule (e #b01 #b01))
(rule (e #b01 #b10))
(rule (e #b10 #b11))
(rule (e #b11 #b01))
(rule (e #b00 #b01))
(rule (e #b11 #b00))
(rule (e #b01 #b10))
(rule (b #b11))
(rule (n #b01))
(rule (b #b01))
(rule (n #b10))
(rule (b #b11))
(rule (n #b11))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (a x z)))
(rule (=> (and (a x y) (e y z)) (t x z)))
(rule (=> (and (a x y) (b y)) (c y x)))
(rule (=> (c x y) (a x y)))
(rule (=> (a #b01 y) q))
(query q)
