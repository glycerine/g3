(set-option :fixedpoint.engine datalog)
(define-sort s () (_ BitVec 3))
(declare-rel r (s s) interval_relation tr_sparse)
(declare-rel e (s s))
(declare-var x s)
(declare-var y s)
(declare-var z s)
(rule (e #b001 #b010))
(rule (e #b010 #b011))
(rule (e #b011 #b001))
(rule (=> (e x y) (r x y)))
(rule (=> (and (r x y) (e y z)) (r x z)))
(query r :print-answer true)
