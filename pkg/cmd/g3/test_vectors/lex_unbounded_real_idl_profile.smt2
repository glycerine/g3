(set-option :produce-models true)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const x Int)
(declare-const y Real)
(assert (<= x 7))
(assert (=> a (< x 3)))
(assert (=> b (> x 1)))
(assert (or c (> x 6)))
(assert-soft c :weight 4 :id p)
(maximize x)
(maximize y)
(assert-soft a :weight 2 :id q)
(assert-soft b :weight -3 :id q)
(assert-soft (not c) :weight 1.5 :id s)
(check-sat)
(get-objectives)
(push 1)
(assert (not a))
(check-sat)
(get-objectives)
(pop 1)
(check-sat)
(get-objectives)
