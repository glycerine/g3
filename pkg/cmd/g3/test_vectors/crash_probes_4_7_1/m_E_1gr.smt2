(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(set-option :fixedpoint.datalog.generate_explanations true)
(declare-rel p (Int Bool) bound_relation interval_relation)
(declare-rel r (Bool) bound_relation interval_relation)
(declare-var x Int)
(declare-var b Bool)
(rule (r true))
(rule (=> (and (r b) (not (p x b))) (r false)))
(query r)
