(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation sparse)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(declare-rel p (Int Bool))
(declare-rel r (Bool))
(declare-var x Int)
(declare-var b Bool)
(rule (r true))
(rule (=> (and (r b) (not (p x b))) (r false)))
(query r)
