; nonlinear default_table=bitvector default_relation=doc inline_eager=false subsumption=false default_table_checked=true default_table_checker=lazy_sparse all_or_nothing_deltas=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.datalog.subsumption false)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker lazy_sparse)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(define-sort N () (_ BitVec 2))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b01 #b11))
(rule (e #b11 #b11))
(rule (e #b10 #b00))
(rule (b #b01))
(rule (n #b01))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (t y z)) (t x z)))
(rule (=> (t #b00 #b01) q))
(query q)
