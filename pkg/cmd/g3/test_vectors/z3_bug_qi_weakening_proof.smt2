(set-option :fixedpoint.engine spacer)
(set-option :fixedpoint.xform.instantiate_quantifiers true)
(set-option :fixedpoint.generate_proof_trace true)
(set-option :fixedpoint.print_answer true)
(declare-rel p ())
(declare-var a (Array Bool Bool))
(rule (=> (and (= (select a true) false)
               (forall ((y Bool))
                 (! (= (select a y) false)
                    :pattern ((select a y)))))
          p))
(query p)
