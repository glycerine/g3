; bool default_table=lazy_sparse check_relation=tr_sparse explanations_on_relation_level=true unbound_compressor=false similarity_compressor=false inline_linear=false inline_eager=false compress_unbound=false coi=false default_table_checked=true default_table_checker=sparse unfold_rules=1 inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table lazy_sparse)
(set-option :fixedpoint.datalog.check_relation tr_sparse)
(set-option :fixedpoint.datalog.explanations_on_relation_level true)
(set-option :fixedpoint.datalog.unbound_compressor false)
(set-option :fixedpoint.datalog.similarity_compressor false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.compress_unbound false)
(set-option :fixedpoint.xform.coi false)
(set-option :fixedpoint.datalog.default_table_checked true)
(set-option :fixedpoint.datalog.default_table_checker sparse)
(set-option :fixedpoint.xform.unfold_rules 1)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 2))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b00 #b00))
(rule (e #b10 #b11))
(rule (e #b00 #b10))
(rule (b #b01))
(rule (n #b11))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z) (b z)) (t x z)))
(rule (=> (and (t x x)) (r x)))
(rule (=> (r x) q))
(query q)
