; mutual check_relation=tr_lazy_sparse magic_sets_for_queries=true similarity_compressor=false inline_eager=false magic=true unfold_rules=1 inline_linear_branch=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.check_relation tr_lazy_sparse)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.datalog.similarity_compressor false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.magic true)
(set-option :fixedpoint.xform.unfold_rules 1)
(set-option :fixedpoint.xform.inline_linear_branch true)
(define-sort N () (_ BitVec 4))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b0001 #b1111))
(rule (e #b0000 #b1101))
(rule (e #b1001 #b1010))
(rule (e #b0100 #b1000))
(rule (e #b0010 #b1011))
(rule (e #b1101 #b1100))
(rule (b #b0000))
(rule (n #b0011))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (a x z)))
(rule (=> (and (a x y) (e y z)) (t x z)))
(rule (=> (and (a x y) (b y)) (c y x)))
(rule (=> (c x y) (a x y)))
(rule (=> (a #b0001 y) q))
(query q)
