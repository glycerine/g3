(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.check_relation tr_sparse)
(define-sort s () (_ BitVec 2))
(declare-rel p (s s))
(declare-rel q (s))
(declare-rel r (s))
(declare-var x s)
(declare-var y s)
(rule (p #b00 #b01))
(rule (p #b01 #b10))
(rule (=> (and (p x y) (p y x)) (q x)))
(rule (=> (p x y) (q y)))
(rule (=> (and (p x y) (not (q x))) (r x)))
(query r :print-answer true)
