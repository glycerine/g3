(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(declare-var x1 Int)
(declare-var y1 Int)
(rule (=> (and (= x 2) (= y 1)) (q0 x y)))
(rule (=> (and (q0 x y) (= y 9) (= x1 (+ y 1)) (= y1 (+ x 2))) (q0 x1 y1)))
(rule (=> (and (q0 x y) (= x1 (+ y y)) (= y1 2)) (q0 x1 y1)))
(rule (=> (and (q0 x y) (= x1 x) (= y1 x)) (q0 x1 y1)))
(rule (=> (and (q0 x y) (= y 12) (= x1 (+ y 1)) (= y1 (- y 3))) (q0 x1 y1)))
(rule (=> (and (q0 x y) (>= y 5)) err))
(query err)
