(set-option :timeout 20000)
(set-option :smt.string_solver z3str3)
(declare-const x String)
(declare-const y String)
(push)
(assert (str.in.re x (re.+ (str.to.re "a"))))
(check-sat)
(pop)
(push)
(assert (= x "b"))
(check-sat)
(pop)
(push)
(assert (= y (str.++ x "b")))
(assert (= (str.len y) 3))
(check-sat)
(pop)
