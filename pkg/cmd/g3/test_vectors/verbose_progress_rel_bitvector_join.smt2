(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(declare-rel e ((_ BitVec 8) (_ BitVec 8)))
(declare-rel q ((_ BitVec 8) (_ BitVec 8) (_ BitVec 8) (_ BitVec 8)))
(declare-var x (_ BitVec 8))
(declare-var y (_ BitVec 8))
(declare-var z (_ BitVec 8))
(declare-var w (_ BitVec 8))
(rule (e #x05 #x03))
(rule (e #x03 #x07))
(rule (e #x07 #x01))
(rule (=> (and (e x y) (e z w)) (q x y z w)))
(query q :print-answer true)
