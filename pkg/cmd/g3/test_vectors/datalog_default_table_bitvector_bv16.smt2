(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(declare-rel e ((_ BitVec 16) (_ BitVec 4)))
(declare-rel t ((_ BitVec 16) (_ BitVec 4)))
(declare-rel s ((_ BitVec 4) (_ BitVec 16)))
(declare-var x (_ BitVec 16))
(declare-var y (_ BitVec 4))
(declare-var z (_ BitVec 16))
(rule (e #x0009 #x3))
(rule (e #x0103 #x7))
(rule (e #x0007 #x1))
(rule (e #xf001 #xc))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e z y)) (s y z)))
(query s :print-answer true)
