(set-option :smt.macro_finder true)
(declare-fun L (Int Int) Bool)
(declare-fun K (Int) Int)
(declare-fun G (Int Int) Bool)
(declare-fun n () Int)
(declare-fun t () Int)
(declare-fun b () Bool)
(declare-fun c () Bool)
(assert (forall ((x Int) (y Int)) (= (L x y) (ite b (G x y) (ite (and (= x n) (= y t)) true (G x y))))))
(assert (forall ((y Int)) (= (K y) (+ y 1))))
(push)
(assert (not (or c (L (K t) t))))
(check-sat)
(pop)
