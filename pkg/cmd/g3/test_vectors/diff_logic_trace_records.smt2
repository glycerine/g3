(set-option :smt.auto_config false)
(set-option :smt.arith.solver 1)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-fun f (Int) Int)
(assert (<= (- x y) 0))
(assert (<= (- y z) 0))
(assert (or (<= (- z x) (- 1)) (<= (- (f z) x) (- 5))))
(assert (>= (- (f z) y) 0))
(check-sat)
