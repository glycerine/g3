; chain3 default_table=bitvector check_relation=tr_check magic_sets_for_queries=true unbound_compressor=false inline_eager=false coi=false default_table_checker=lazy_sparse all_or_nothing_deltas=true subsumption_checker=false unfold_rules=1 tail_simplifier_pve=false fix_unbound_vars=true
(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(set-option :fixedpoint.datalog.check_relation tr_check)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(set-option :fixedpoint.datalog.unbound_compressor false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.coi false)
(set-option :fixedpoint.datalog.default_table_checker lazy_sparse)
(set-option :fixedpoint.datalog.all_or_nothing_deltas true)
(set-option :fixedpoint.xform.subsumption_checker false)
(set-option :fixedpoint.xform.unfold_rules 1)
(set-option :fixedpoint.xform.tail_simplifier_pve false)
(set-option :fixedpoint.xform.fix_unbound_vars true)
(define-sort N () (_ BitVec 2))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-rel b (N))
(declare-rel a (N N))
(declare-rel c (N N))
(declare-rel r (N))
(declare-rel n (N))
(declare-rel s (N))
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b10 #b01))
(rule (e #b00 #b01))
(rule (e #b11 #b01))
(rule (e #b10 #b00))
(rule (e #b11 #b00))
(rule (e #b10 #b10))
(rule (b #b11))
(rule (n #b00))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (a x z)))
(rule (=> (and (a x y) (e y z)) (c x z)))
(rule (=> (and (c x y) (e y z)) (t x z)))
(rule (=> (and (c x y) (n y)) q))
(query q)
