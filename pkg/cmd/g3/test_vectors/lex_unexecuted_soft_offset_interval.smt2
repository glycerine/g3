(set-option :produce-models true)
(declare-const a Bool)
(declare-const b Bool)
(declare-const x Int)
(declare-const y Int)
(assert (<= x 5))
(assert (=> a (< x 3)))
(assert (=> b (> x 1)))
(maximize x)
(maximize y)
(assert-soft a :weight 2 :id q)
(assert-soft b :weight -1 :id q)
(check-sat)
(get-objectives)
