(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int) (y Int)) (=> (< (f (- a a)) (f 1)) (p (g (g x a) a)))))
(assert (forall ((x Int) (y Int)) (! (=> (not (= (+ a a) x)) (= a (f (f x)))) :pattern ((f x)))))
(assert (forall ((x Int)) (! (=> (= (+ (+ a b) 2) (- (f x) (ite (= b x) 1 0))) (<= a (+ (ite (p a) 2 0) (ite (< 1 a) 0 a)))) :pattern ((f x)))))
(assert (not (<= a (f b))))
(assert (= (f (ite (p a) a a)) 2))
(check-sat)
(get-model)
