(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (! (=> (= (f a) 2) (= (ite (= (+ 0 1) (- 1 0)) (g x 0) (g 1 1)) 1)) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (! (=> (p (f (- b y))) (= 0 2)) :pattern ((f x)))))
(assert (forall ((x Int) (y Int)) (! (=> (< (f (ite (< b x) b 1)) (f (+ b b))) (= (g (g 1 1) (+ x 0)) (- (- x b) (f a)))) :pattern ((f x)))))
(assert (< a 0))
(assert (= (- 0 (f 1)) (ite (= (ite (p 1) b 0) (g b a)) 1 2)))
(assert (p (+ (f a) (- 1 2))))
(check-sat)
(get-model)
