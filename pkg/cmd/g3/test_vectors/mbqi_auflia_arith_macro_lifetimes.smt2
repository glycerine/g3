(set-logic AUFLIA)
(declare-fun f (Int) Int)
(declare-fun h (Int Int) Int)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (or (< x 0) (> x 9) (and (>= (f x) (* 2 x)) (<= (f x) (+ (* 2 x) 3))))))
(assert (forall ((x Int) (y Int)) (=> (and (>= x 0) (<= x 3) (>= y 0) (<= y 3)) (= (h x y) (+ (f x) y)))))
(assert (> (+ (h a b) (f 2)) 13))
(assert (and (>= a 0) (<= a 3) (>= b 0) (<= b 3)))
(check-sat)
(get-value (a b (f a) (h a b)))
