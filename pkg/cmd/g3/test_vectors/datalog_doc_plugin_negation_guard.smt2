(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(declare-rel e ((_ BitVec 4) (_ BitVec 4)))
(declare-rel b ((_ BitVec 4)))
(declare-rel q ((_ BitVec 4) (_ BitVec 4)))
(declare-var x (_ BitVec 4))
(declare-var y (_ BitVec 4))
(rule (e #x1 #x2))
(rule (e #x2 #x3))
(rule (e #x3 #x3))
(rule (e #x7 #x9))
(rule (b #x2))
(rule (b #x9))
(rule (=> (and (e x y) (not (b y)) (bvult x #x5)) (q x y)))
(query q :print-answer true)
