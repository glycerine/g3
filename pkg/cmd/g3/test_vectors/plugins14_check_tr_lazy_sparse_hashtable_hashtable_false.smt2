(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.check_relation tr_lazy_sparse)
(set-option :fixedpoint.datalog.default_table hashtable)
(set-option :fixedpoint.datalog.default_table_checked false)
(set-option :fixedpoint.datalog.default_table_checker hashtable)
(define-sort N () (_ BitVec 3))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel b (N))
(declare-rel q ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b001 #b010))
(rule (e #b010 #b011))
(rule (e #b011 #b001))
(rule (e #b100 #b101))
(rule (b #b010))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(declare-rel c (N))
(rule (=> (and (t x y) (not (b y))) (c x)))
(rule (=> (t #b001 #b001) q))
(query q)
(query t :print-answer true)
(query c :print-answer true)
