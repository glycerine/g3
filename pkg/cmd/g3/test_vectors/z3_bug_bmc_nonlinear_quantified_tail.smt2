(set-option :fixedpoint.engine qbmc)
(declare-rel p (Int))
(declare-var x Int)
(rule (p 0))
(rule (=> (and (p x) (< x 3)) (p (+ x 1))))
(query p :print-certificate true)
(declare-rel r (Int))
(rule (=> (and (p x) (p (+ x 1)) (forall ((z Int)) (=> (> z 0) (> (+ z x) 0)))) (r x)))
(query r :print-answer true)
