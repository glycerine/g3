(set-option :fixedpoint.engine duality)
(declare-rel p (Real Real))
(declare-rel q2 (Real))
(declare-rel err ())
(declare-rel ok ())
(declare-var s Real)
(declare-var v Real)
(rule (=> (not (<= s 0.0)) (p s s)))
(rule (=> (and (p v s) (not (<= s 0.0)) (= v (* 2.0 s))) (q2 s)))
(rule (=> (and (q2 s) (not (<= s 0.0))) err))
(rule (=> (and (p s s) (not (<= s 0.0))) ok))
(query err)
(query ok)
