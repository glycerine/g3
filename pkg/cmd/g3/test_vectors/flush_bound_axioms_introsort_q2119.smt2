(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int) (y Int)) (=> (= (ite (not (p y)) (f 2) (- 1 a)) (ite (= a (ite (= 1 2) x y)) (g 0 2) x)) (= x (ite (< (+ x 2) (+ y 0)) (g y a) (- b a))))))
(assert (< (+ (+ a 1) (- 2 2)) (ite (= (ite (p a) 1 1) 2) (f a) (- 0 b))))
(assert (= (- (ite (= 0 b) a 0) (g b 0)) b))
(assert (p 1))
(check-sat)
(get-model)
