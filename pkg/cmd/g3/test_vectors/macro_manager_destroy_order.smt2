(set-option :smt.macro_finder true)
(declare-fun M (Int Int) Bool)
(declare-fun N (Int) Bool)
(declare-fun h (Int) Int)
(declare-fun a () Int)
(declare-fun t () Int)
(declare-fun n () Int)
(declare-fun b () Bool)
(declare-fun c () Bool)
(assert (forall ((x Int) (y Int)) (= (M x y) (> (h x) y))))
(assert (forall ((y Int)) (= (N y) (ite b (M (h y) y) (or (and (= (h y) n) (= y a)) (M (h y) y))))))
(push)
(assert (not (or c (N t))))
(check-sat)
(pop)
