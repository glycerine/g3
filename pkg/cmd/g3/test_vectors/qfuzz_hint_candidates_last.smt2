(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (=> (p 1) (<= (ite (not (< 2 a)) 2 2) (- (g x b) (f 2))))))
(assert (forall ((x Int)) (=> (not (= (g 0 2) b)) (< (- (+ a 2) a) 2))))
(assert (forall ((x Int)) (! (< (- (g 0 x) (- 1 2)) (g (g 2 a) (f x))) :pattern ((f x)))))
(assert (not (< (+ b 2) b)))
(assert (p a))
(assert (< (- (ite (p a) b 2) a) (- (g a 0) (ite (p 2) b a))))
(check-sat)
(get-model)
