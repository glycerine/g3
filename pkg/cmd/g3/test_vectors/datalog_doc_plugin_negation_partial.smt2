(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(declare-rel e ((_ BitVec 3) (_ BitVec 3)))
(declare-rel n ((_ BitVec 3) (_ BitVec 3)))
(declare-rel q ((_ BitVec 3) (_ BitVec 3)))
(declare-rel s ((_ BitVec 3)))
(declare-var x (_ BitVec 3))
(declare-var y (_ BitVec 3))
(rule (e #b001 #b010))
(rule (e #b011 #b010))
(rule (e #b011 #b100))
(rule (n #b011 #b100))
(rule (s #b011))
(rule (=> (and (e x y) (not (n x y))) (q x y)))
(rule (=> (and (e x y) (not (s x)) (not (= x y)) (or (= y #b010) (= x #b111))) (q y x)))
(query q :print-answer true)
