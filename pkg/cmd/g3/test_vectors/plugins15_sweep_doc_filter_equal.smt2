(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.datalog.magic_sets_for_queries true)
(define-sort N () (_ BitVec 2))
(declare-rel e (N N))
(declare-rel t (N N))
(declare-rel b (N))
(declare-rel q ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b01 #b10))
(rule (e #b10 #b11))
(rule (b #b10))
(rule (=> (e x y) (t x y)))
(rule (=> (and (t #b01 y) (e y z)) (t #b01 z)))
(rule (=> (and (t x y) (b y)) (t y x)))
(rule (=> (t #b01 #b11) q))
(query q)
