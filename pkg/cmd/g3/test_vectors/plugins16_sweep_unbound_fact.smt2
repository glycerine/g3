(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.coi false)
(define-sort N () (_ BitVec 3))
(declare-rel e (N N))
(declare-rel p (N N))
(declare-rel t (N N))
(declare-rel q ())
(declare-var x N)
(declare-var y N)
(declare-var z N)
(rule (e #b001 #b010))
(rule (e #b010 #b011))
(rule (p #b001 x))
(rule (p #b011 x))
(rule (=> (and (p x y) (e x z)) (t x z)))
(rule (=> (and (t x y) (e y z)) (t x z)))
(rule (=> (t #b001 #b011) q))
(query q)
