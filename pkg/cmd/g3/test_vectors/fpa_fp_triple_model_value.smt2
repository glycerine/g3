(set-logic QF_FP)
(declare-const rm RoundingMode)
(declare-const z (_ FloatingPoint 8 24))
(push)
(assert (= z ((_ to_fp 8 24) rm 0.5)))
(check-sat)
(get-value (z))
(eval (fp.isZero z))
(eval (fp.add RNE z z))
(pop)
(push)
(assert (= z ((_ to_fp 8 24) rm 0.0)))
(check-sat)
(get-value (z))
(eval (fp.isZero z))
(pop)
