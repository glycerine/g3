(set-logic QF_FP)
(declare-const r RoundingMode)
(declare-const x (_ FloatingPoint 3 4))
(assert (= r RNE))
(assert (= x (fp.add r (fp #b0 #b011 #b000) (fp #b0 #b000 #b001))))
(check-sat)
(get-value (r x))
(declare-const s RoundingMode)
(assert (not (= s RNE)))
(assert (not (= s RTZ)))
(assert (not (= s RTP)))
(assert (not (= s RTN)))
(check-sat)
(get-value (s))
