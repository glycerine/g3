(set-option :fixedpoint.engine datalog)
(declare-rel r ((_ BitVec 16) (_ BitVec 16)))
(declare-rel e ((_ BitVec 16) (_ BitVec 16)))
(declare-rel s ((_ BitVec 16)))
(declare-var x (_ BitVec 16))
(declare-var y (_ BitVec 16))
(declare-var z (_ BitVec 16))
(rule (s #x0000))
(rule (=> (and (s x) (bvult x #x0040)) (s (bvadd x #x0001))))
(rule (=> (and (s x) (s y) (bvult x y)) (e x y)))
(rule (=> (e x y) (r x y)))
(rule (=> (and (r x y) (e y z)) (r x z)))
(query r)
