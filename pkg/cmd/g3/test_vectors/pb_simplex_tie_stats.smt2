(set-option :auto_config false)
(set-option :smt.pb.conflict_frequency 2)
(set-option :smt.pb.enable_compilation true)
(set-option :smt.pb.enable_simplex true)
(set-option :smt.pb.learn_complements true)
(set-logic ALL)
(declare-const v0 Bool)
(declare-const v1 Bool)
(declare-const v2 Bool)
(declare-const v3 Bool)
(declare-const v4 Bool)
(declare-const v5 Bool)
(declare-const v6 Bool)
(declare-const v7 Bool)
(declare-const v8 Bool)
(assert (not ((_ at-most 1) v3 v4 v1 v7 (not v5))))
(assert ((_ at-least 3) (not v6) v4 (not v5) v0 v2 v1))
(assert ((_ pbge 9 3 4 5 4) v1 v8 v2 v3))
(assert ((_ pbge 9 2 5 4 1 2) (not v4) v5 (not v8) v6 (not v1)))
(assert ((_ pbeq 6 4 4 4 3 3) v2 v3 (not v4) (not v1) v6))
(assert ((_ pbeq 2 3 3 1 1 2) v5 v4 v0 v1 (not v2)))
(assert ((_ pbge 3 2 2 1 3) v0 (not v7) v5 v4))
(assert (or v8 v7))
(check-sat)
