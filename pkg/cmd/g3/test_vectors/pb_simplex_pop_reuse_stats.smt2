(set-option :auto_config false)
(set-option :smt.pb.enable_simplex true)
(set-option :smt.pb.enable_compilation false)
(set-option :smt.pb.conflict_frequency 1)
(set-logic ALL)
(declare-const v0 Bool)
(declare-const v1 Bool)
(declare-const v2 Bool)
(declare-const v3 Bool)
(declare-const v4 Bool)
(declare-const v5 Bool)
(declare-const v6 Bool)
(declare-const v7 Bool)
(declare-const v8 Bool)
(assert ((_ pble 1 3 3) (not v6) v3))
(push 1)
(assert (not ((_ pble 2 4 1 1 1 2) v4 (not v6) v2 v5 v8)))
(assert ((_ pbeq 5 4 3 5) v4 v8 v0))
(check-sat)
(pop 1)
(push 1)
(assert ((_ pble 1 1 3 2 5 3 4) (not v4) v2 v3 v8 v1 v7))
(check-sat)
(pop 1)
(check-sat)
