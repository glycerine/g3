(set-logic QF_NIA)
(set-option :produce-models true)
(declare-const p Bool)
(declare-const x Int)
(assert (= x (ite p 1 2)))
(assert (= (* x x) 4))
(check-sat-using qfnia)
(get-value (p x))
(reset)
(set-logic QF_NIA)
(declare-const p Bool)
(declare-const x Int)
(assert (= (+ (ite p 1 2) 3) 4))
(assert (not p))
(check-sat-using qfnia)
