(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int))
(declare-rel q1 (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var x1 Int)
(rule (=> (and (= x 0)) (q0 x)))
(rule (=> (and (q1 x) (>= x 2) (= x1 0)) (q1 x1)))
(rule (=> (and (q0 x) (<= x 0) (= x1 1)) (q0 x1)))
(rule (=> (and (q1 x) (= x 11) (= x1 x)) (q0 x1)))
(rule (=> (and (q0 x) (> x 2)) err))
(query err :print-certificate true)
