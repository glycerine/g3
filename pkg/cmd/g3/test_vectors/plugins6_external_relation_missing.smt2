(set-option :fixedpoint.engine datalog)
(declare-rel p (Int) external_relation)
(declare-rel r (Bool) external_relation)
(declare-rel s (Bool) interval_relation external_relation)
(declare-var b Bool)
(rule (r true))
(rule (=> (r b) (r (not b))))
(rule (=> (r b) (s b)))
(query p)
(query r :print-answer true)
(query s :print-answer true)
