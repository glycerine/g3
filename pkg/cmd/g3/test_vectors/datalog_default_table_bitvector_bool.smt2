(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_table bitvector)
(declare-rel e ((_ BitVec 3) Bool))
(declare-rel t ((_ BitVec 3) Bool))
(declare-var x (_ BitVec 3))
(declare-var b Bool)
(rule (e #b101 true))
(rule (e #b011 false))
(rule (e #b001 true))
(rule (=> (and (e x b) (bvugt x #b010)) (t x b)))
(query t :print-answer true)
