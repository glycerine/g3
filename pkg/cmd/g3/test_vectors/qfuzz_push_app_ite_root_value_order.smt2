(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (=> (p 0) (< (ite (= (g 0 x) (+ x x)) (+ b x) (- a 1)) a))))
(assert (forall ((x Int) (y Int)) (=> (not (<= y (- 0 x))) (not (<= (g 2 a) (g 1 a))))))
(assert (= (- (+ 2 a) (ite (<= 0 0) b 0)) 2))
(check-sat)
(get-model)
