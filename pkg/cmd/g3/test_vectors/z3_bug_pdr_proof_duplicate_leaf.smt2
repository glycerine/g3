(set-option :fixedpoint.engine pdr)
(set-option :fixedpoint.generate_proof_trace true)
(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(declare-rel a (Bool))
(declare-rel p (Bool))
(declare-rel q (Bool))
(declare-rel r (Bool))
(declare-rel goal ())
(declare-var v Bool)
(rule (=> (= v true) (a v)))
(rule (=> (a v) (p v)))
(rule (=> (p v) (q v)))
(rule (=> (p v) (r v)))
(rule (=> (and (q true) (r true)) goal))
(query goal :print-certificate true)
