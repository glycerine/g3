(set-option :fixedpoint.engine datalog)
(define-sort s () (_ BitVec 2))
(declare-rel e (s s))
(declare-rel q (s))
(declare-rel r (s s))
(declare-rel t ())
(declare-var x s)
(declare-var y s)
(declare-var z s)
(rule (e #b00 #b01))
(rule (e #b01 #b10))
(rule (q #b11))
(rule (=> (and (e x y) (not (q z)) (bvult x z)) (r x y)))
(rule (=> (not (q z)) t))
(rule (=> (and (e x y) (not (q #b10)) (not (e y x))) (r y x)))
(query r :print-answer true)
(query t :print-answer true)
