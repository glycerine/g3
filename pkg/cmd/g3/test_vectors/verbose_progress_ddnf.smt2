(declare-rel r ((_ BitVec 4)))
(declare-rel s ((_ BitVec 4)))
(declare-rel t ((_ BitVec 4)))
(declare-var x (_ BitVec 4))
(rule (r #x1))
(rule (r #x3))
(rule (=> (and (r x) (= ((_ extract 0 0) x) #b1)) (s x)))
(rule (=> (and (s x) (= ((_ extract 2 1) x) #b01)) (t x)))
(rule (=> (and (r x) (= ((_ extract 3 2) x) #b00)) (t x)))
(query t)
