(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation bound_relation)
(declare-rel p (Int))
(declare-rel r (Bool))
(declare-rel s (Bool Bool))
(declare-var x Int)
(declare-var b Bool)
(declare-var c Bool)
(rule (r true))
(rule (=> (and (r b) (p x) (> x 3)) (s b false)))
(rule (=> (and (s b c) (not (p x)) (< x 1)) (r c)))
(rule (=> (and (r b) (s c b)) (s b b)))
(query s :print-answer true)
