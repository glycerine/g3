(set-option :fixedpoint.spacer.minimize_unsat_core true)
(set-option :fixedpoint.engine spacer)
(declare-rel inv (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var y Int)
(rule (=> (= x 5) (inv x)))
(rule (=> (= x 0) (inv x)))
(rule (=> (= x 3) (inv x)))
(rule (=> (and (inv x) (< x 10) (= y (+ x 2))) (inv y)))
(rule (=> (and (inv x) (> x 100)) err))
(query err :print-certificate true)
