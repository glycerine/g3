(set-logic ALL)
(declare-const x Int)
(declare-const y Real)
(push)
(assert (and (<= 0 x) (<= x 1) (= x 1)))
(check-sat-using (then elim01 smt))
(pop)
(push)
(assert (> x 1))
(check-sat-using lia)
(pop)
(push)
(assert (> y 1))
(check-sat-using lra)
(pop)
(push)
(assert (> y (to_real x)))
(check-sat-using lira)
(pop)
