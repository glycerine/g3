(set-logic ALL)
(declare-const k Real)
(assert (= k (- 1)))
(assert (exists ((x Real)) (= (* x x) k)))
(check-sat-using (then nlqe nlqsat))
(reset)
(set-logic ALL)
(declare-const k Real)
(assert (= k 2))
(assert (exists ((x Real)) (= (* x x) k)))
(check-sat-using (then nlqe nlqsat))
(reset)
(set-logic ALL)
(declare-const k Real)
(assert (= k 0))
(assert (exists ((x Real)) (forall ((y Real)) (<= (* x x) (+ (* y y) k)))))
(check-sat-using (then nlqe nlqsat))
