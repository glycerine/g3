(set-option :fixedpoint.engine pdr)(set-option :fixedpoint.xform.inline_eager false)(set-option :fixedpoint.xform.inline_linear false)
(declare-rel Q (Int Int))
(declare-rel P (Int Int))
(declare-rel R (Int Int))
(declare-rel G ())
(declare-var x Int)
(declare-var y Int)
(declare-var a Int)
(declare-var b Int)
(rule (Q 0 0))
(rule (=> (and (Q x a) (= y (+ x 1)) (= b (* a a)) (< x 10)) (Q y b)))
(rule (=> (and (Q x a) (= b (+ a 1))) (P x b)))
(rule (=> (and (P x a) (= b (+ a 1))) (R x b)))
(rule (=> (and (P y b) (R x a) (= y (+ x 1)) (> x 20)) G))
(query G :print-certificate true)
