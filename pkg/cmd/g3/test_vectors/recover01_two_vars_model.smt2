(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(assert (or p q (= x 0)))
(assert (or (not p) q (= x 3)))
(assert (or p (not q) (= x 5)))
(assert (or (not p) (not q) (= x 8)))
(assert (or r (= y 0)))
(assert (or (not r) (= y 7)))
(assert (> (+ x y) 9))
(check-sat-using (then recover-01 smt))
(get-model)
