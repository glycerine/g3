(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(set-option :fixedpoint.datalog.default_table sparse)
(define-sort V () (_ BitVec 2))
(declare-rel p (V V))
(declare-rel t (Bool))
(declare-rel h (V V Bool))
(declare-var x V)
(declare-var y V)
(declare-var b Bool)
(rule (p #b00 #b01))
(rule (t true))
(rule (=> (and (p x y) (t b)) (h x y b)))
(query h :print-answer true)
