(declare-const x Real)
(declare-const y Real)
(simplify (+ x (^ 2.0 0.5) 1.0))
(simplify (* x (^ 2.0 0.5) 3.0))
(simplify (* (^ 2.0 0.5) x (^ 2.0 0.5)))
(simplify (+ x (^ 2.0 0.5) y (^ 2.0 0.5)))
(simplify (+ (^ 2.0 0.5) 1.0))
(simplify (* (^ 2.0 0.5) (^ 2.0 0.5)))
(simplify (+ (^ 2.0 0.5) (^ 3.0 0.5) (^ 5.0 0.5) x) :max_degree 3)
(simplify (+ (^ 2.0 0.5) x))
(simplify (* (^ 2.0 0.5) (- 1.0) x y))
(simplify (+ (root-obj (+ (^ x 3) (- 2)) 1) 1.0 x) :max_degree 2)
