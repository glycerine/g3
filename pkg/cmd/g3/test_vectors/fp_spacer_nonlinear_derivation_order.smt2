(set-option :fixedpoint.xform.slice false)
(set-option :fixedpoint.xform.inline_linear false)
(set-option :fixedpoint.xform.inline_eager false)
(set-option :fixedpoint.engine spacer)
(declare-rel P (Int Int))
(declare-rel Q (Int Int))
(declare-rel bad ())
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(declare-var w Int)
(rule (P 0 0))
(rule (=> (and (P x y) (< x 9)) (P (+ x 1) (+ y 2))))
(rule (Q 0 1))
(rule (=> (and (Q x y) (< x 7)) (Q (+ x 1) (+ y 3))))
(rule (=> (and (P x y) (Q z w) (= (+ y w) 25) (> x 3)) bad))
(query bad :print-answer true)
