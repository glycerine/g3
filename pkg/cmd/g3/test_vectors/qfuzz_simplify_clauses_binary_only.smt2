(set-option :produce-models true)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun p (Int) Bool)
(declare-const a Int)
(declare-const b Int)
(assert (forall ((x Int)) (= (f (+ 2 x)) a)))
(assert (forall ((x Int)) (= (ite (<= 0 (g b x)) (+ 2 1) (+ a 2)) (f a))))
(assert (= (ite (<= b 2) (- 1 a) (g 2 0)) 1))
(assert (not (= (g 1 a) 1)))
(check-sat)
(get-model)
