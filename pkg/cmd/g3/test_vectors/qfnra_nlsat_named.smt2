(set-logic QF_NRA)
(declare-const x Real)
(push)
(assert (= (* x x) 4))
(check-sat-using qfnra-nlsat)
(pop)
(push)
(assert (= (+ (* x x) 1) 0))
(check-sat-using qfnra-nlsat)
(pop)
(push)
(assert (= (* x x) 4))
(check-sat-using (using-params qfnra-nlsat :factor false))
(pop)
(push)
(assert (= (/ x 2) 1))
(check-sat-using qfnra-nlsat)
(pop)
(push)
(assert (not (= (/ x 2) (* x (/ 1 2)))))
(check-sat-using qfnra-nlsat)
(pop)
