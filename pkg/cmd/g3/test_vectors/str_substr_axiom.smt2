(set-logic QF_S)
(declare-const p0 Bool)
(declare-const p1 Bool)
(declare-const x0 Int)
(declare-const s0 String)
(declare-const s1 String)
(assert (str.prefixof (str.replace (str.replace s0 "ab" s0) s1 (str.substr "b" x0 x0)) (str.at (str.++ s0 s1) (* 0 x0))))
(assert (=> p1 p1))
(assert (distinct (mod (str.len s0) 0) (+ (mod 1 2) (+ x0 0))))
(assert p1)
(assert (xor (= (div x0 100) (abs 3)) p0))
(check-sat)
(get-model)
