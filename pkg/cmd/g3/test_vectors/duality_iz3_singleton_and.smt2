(set-option :fixedpoint.engine duality)
(declare-rel q0 (Int))
(declare-rel q1 (Int))
(declare-rel q2 (Int))
(declare-rel err ())
(declare-var x Int)
(declare-var x1 Int)
(rule (=> (and (= x 1)) (q0 x)))
(rule (=> (and (q0 x) (< x 7) (= x1 x)) (q2 x1)))
(rule (=> (and (q1 x) (<= x 7) (= x1 4)) (q0 x1)))
(rule (=> (and (q2 x) (>= x 3)) err))
(query err :print-certificate true)
