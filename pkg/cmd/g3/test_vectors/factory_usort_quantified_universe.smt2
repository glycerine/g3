(declare-sort U 0)
(declare-sort V 0)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun c () U)
(declare-fun h (U) V)
(declare-fun k (V) U)
(declare-const v1 V)
(declare-const v2 V)
(declare-const v3 V)
(assert (distinct a b c))
(assert (distinct v1 v2 v3))
(assert (forall ((x U)) (or (= x a) (= x b) (= x c))))
(assert (not (= (h a) (h b))))
(check-sat)
(get-model)
(get-value ((k v1) (k v2) (h c) (k (h c))))
