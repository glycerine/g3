(declare-fun p ((_ BitVec 2) Int) Bool)
(declare-fun q ((_ BitVec 1) (_ BitVec 8)) Bool)
(declare-fun r ((_ BitVec 3)) Bool)
(assert (forall ((x (_ BitVec 2)) (i Int)) (p x i)))
(assert (exists ((y (_ BitVec 1)) (z (_ BitVec 8))) (q y z)))
(assert (forall ((x (_ BitVec 2))) (=> (p x 3) (exists ((w (_ BitVec 1))) (q w #x01)))))
(assert (forall ((u (_ BitVec 3))) (or (r u) (= u #b101))))
(apply elim-small-bv)
(apply (using-params elim-small-bv :max_bits 1))
