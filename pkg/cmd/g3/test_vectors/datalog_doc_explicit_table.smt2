(set-option :fixedpoint.engine datalog)
(set-option :fixedpoint.datalog.default_relation doc)
(define-sort s () (_ BitVec 3))
(declare-rel e (s s) tr_hashtable)
(declare-rel f (s s) tr_hashtable)
(declare-rel p (s s))
(declare-rel q (s))
(declare-var x s)
(declare-var y s)
(declare-var z s)
(rule (e #b001 #b010))
(rule (e #b010 #b011))
(rule (=> (and (e x y) (e y z)) (f x z)))
(rule (p #b001 #b011))
(rule (=> (p x y) (q y)))
(query f :print-answer true)
(query q :print-answer true)
