(set-option :produce-models true)
(set-logic QF_NRA)
(declare-const x0 Real)
(declare-const x1 Real)
(declare-const t Real)
(assert (= (* t t) 2))
(assert (= (* x0 x0) t))
(assert (> x0 0))
(assert (= (* x1 x1) t))
(assert (= (>= x0 x1) (<= x1 x0)))
(check-sat)
(get-value ((= (* x0 x0) t) (= (* x1 x1) t)))
(push)
(assert (< x0 0))
(check-sat)
(pop)
(check-sat-using qfnra-nlsat)
